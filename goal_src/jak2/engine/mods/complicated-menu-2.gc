    (rule-hands-on?                 symbol)

    ;; Complications
    (complication-brittle-bones?    symbol)
    (complication-rotten-eggs?      symbol)
    (complication-eco-allergy?      symbol)
    (complication-sizeable?         symbol)
    (complication-ohko?             symbol)
    (complication-glare?            symbol)
