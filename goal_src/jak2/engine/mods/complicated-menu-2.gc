    :falsey-text (text-id progress-off)
    :get-value-fn (lambda () (-> *complicated-settings* show-countup-timer?))
    :on-confirm (lambda ((val symbol))
      (set! (-> *complicated-settings* show-countup-timer?) val)
      ;; (complicated-settings-save)
      )
    )
  )

