(defmacro mod-page-timer ()
  `(mod-progress-new-generic-link-to-scrolling-page (text-id mod-progress-timer-options)
    (mod-option-countup-timer)
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-countdown-start-time)
      :description (text-id mod-progress-countdown-start-time-desc)
      :min-value 5.0
      :max-value 600.0
      :step 5.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* countdown-start-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* countdown-start-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-time-limit-multiplier)
      :description (text-id mod-progress-time-limit-multiplier-desc)
      :min-value 0.5
      :max-value 2.0
      :step 0.01
      :show-decimal? #f
      :units 'percent
      :get-value-fn (lambda () (-> *complicated-settings* time-limit-multiplier))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* time-limit-multiplier) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-tier-1-increment)
      :description (text-id mod-progress-tier-1-increment-desc)
      :min-value -10.0
      :max-value 30.0
      :step 1.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* tier-1-increment-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* tier-1-increment-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-tier-2-increment)
      :description (text-id mod-progress-tier-2-increment-desc)
      :min-value -60.0
      :max-value 60.0
      :step 1.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* tier-2-increment-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* tier-2-increment-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-tier-3-increment)
      :description (text-id mod-progress-tier-3-increment-desc)
      :min-value -30.0
      :max-value 120.0
      :step 1.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* tier-3-increment-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* tier-3-increment-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-compliance-increment)
      :description (text-id mod-progress-compliance-increment-desc)
      :min-value 0.0
      :max-value 30.0
      :step 1.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* compliance-increment-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* compliance-increment-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-slider-option
      :name (text-id mod-progress-condition-delay)
      :description (text-id mod-progress-condition-delay-desc)
      :min-value 0.0
      :max-value 30.0
      :step 1.0
      :show-decimal? #f
      :units 'seconds
      :get-value-fn (lambda () (-> *complicated-settings* condition-delay-seconds))
      :on-confirm (lambda ((val float))
        (set! (-> *complicated-settings* condition-delay-seconds) val)
        ;; (complicated-settings-save)
        )
      )
    )
  )

(defmacro mod-option-game-mode ()
  '(new 'static 'mod-menu-generic-carousel-option
    :name (text-id mod-progress-game-mode)
    :items (new 'static 'boxed-array :type text-id
      (text-id mod-progress-game-mode-casual)
      (text-id mod-progress-game-mode-timed)
      )
    :get-item-index-fn (lambda () 
      ;; (-> *complicated-settings* game-mode)
      (case (-> *complicated-settings* game-mode)
        (('casual) 0)
        (('timed) 1)
        )
      )
    :on-confirm (lambda ((index int) (the-progress progress))
      (set! (-> *complicated-settings* game-mode) (-> *mod-game-mode* index))
      ;; (complicated-settings-save)
      )
    )
  )

(defmacro mod-option-difficulty ()
  '(new 'static 'mod-menu-generic-carousel-option
    :name (text-id mod-progress-difficulty)
    :description (text-id mod-progress-difficulty-desc)
    :items (new 'static 'boxed-array :type text-id
      (text-id mod-progress-difficulty-1)
      (text-id mod-progress-difficulty-2)
      (text-id mod-progress-difficulty-3)
      (text-id mod-progress-difficulty-4)
      )
    :get-item-index-fn (lambda () 
      ;; (-> *complicated-settings* game-mode)
      (case (-> *complicated-settings* difficulty)
        (('easy) 0)
        (('medium) 1)
        (('hard) 2)
        (('unfathomable) 3)
        )
      )
    :on-confirm (lambda ((index int) (the-progress progress))
      (set! (-> *complicated-settings* difficulty) (-> *mod-difficulty* index))
      ;; (complicated-settings-save)
      )
    )
  )
  
(defmacro mod-option-countup-timer ()
  '(new 'static 'mod-menu-generic-boolean-option
