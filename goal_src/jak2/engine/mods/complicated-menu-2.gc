(defmacro mod-option-restore-defaults ()
  '(new 'static 'mod-menu-generic-confirm-option
    :name (text-id progress-restore-defaults)
    :on-confirm (lambda ((val symbol))
      (reset *complicated-settings*)
      ;; (complicated-settings-save)
      )
    )
  )

(defmacro mod-complicated-options ()
  `(progress-new-generic-link-to-scrolling-page (text-id mod-progress-complicated-options)
    (mod-page-timer)
    (mod-page-conditions)
    (mod-page-punishments)
    (mod-option-game-mode)
    (mod-option-difficulty)
    (mod-option-text-scale)
    (mod-option-pass-credits)
    (mod-option-active-conditions)
    (mod-option-restore-defaults)
    )
  )