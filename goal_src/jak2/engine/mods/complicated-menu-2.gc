    ;; (write-to-file (_type_ string) symbol)
    ;; (read-from-file (_type_ string) symbol)
  )
)

(defmethod reset ((obj complicated-settings))
  "Set the default settings"
  (set! (-> obj countdown-start-seconds) 30.0)
  (set! (-> obj condition-delay-seconds) 5.0)
  (set! (-> obj time-limit-multiplier) 1.0)
  (set! (-> obj tier-1-increment-seconds) 5.0)
  (set! (-> obj tier-2-increment-seconds) 10.0)
  (set! (-> obj tier-3-increment-seconds) 30.0)
  (set! (-> obj pass-credits-required) 10)
  (set! (-> obj compliance-increment-seconds) 0.0)
  (set! (-> obj show-countup-timer?) #f)
  (set! (-> obj difficulty) 'easy)
  (set! (-> obj game-mode) 'timed)
  (set! (-> obj text-scale) 1.0)
  (set! (-> obj target-slot-count) 1)
  0
  )

