;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MENU OPTIONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro mod-progress-new-generic-link-to-scrolling-page (title &key (should-disable? #f) &rest options)
  `(new 'static 'mod-menu-generic-link-option
    :name ,title
    :should-disable? ,should-disable?
    :target (new 'static 'menu-option-list
      :options (new 'static 'boxed-array :type menu-option
      (new 'static 'mod-menu-generic-scrolling-page
       :name ,title
       :menu-options (new 'static 'boxed-array :type menu-option
       ,@options))))))

(defmacro mod-page-conditions ()
  `(mod-progress-new-generic-link-to-scrolling-page (text-id mod-progress-condition-options)
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-grounded-name)
      :description (text-id rule-grounded-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-grounded?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* rule-grounded?) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id complication-brittle-bones-name)
      :description (text-id complication-brittle-bones-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* complication-brittle-bones?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* complication-brittle-bones?) val)
        ;; (complicated-settings-save)
        )
      )
    )
  )

