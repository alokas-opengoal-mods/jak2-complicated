    (complication-bus-driver?       symbol)
    (complication-wings-tied?       symbol)
    (complication-fuel-shortage?    symbol)
    (complication-drought?          symbol)
    (complication-jak-rabbit?       symbol)
    (complication-hidden-treasure?  symbol)
    (complication-eco-reserve?      symbol)
    (complication-red-stop?         symbol)
    (complication-rgyb?             symbol)
    (complication-butter-fingers?   symbol)
    (complication-overclock?        symbol)
    (complication-bad-ping?         symbol)
    (complication-invisible-man?    symbol)
    (complication-joyride?          symbol)
    (complication-critical?         symbol)
    (complication-cumbersome?       symbol)
    (complication-double-aphids?    symbol)
    (complication-invert?           symbol)
    (complication-loose-pockets?    symbol)
    (complication-twisted?          symbol)
    (complication-vibe-check?       symbol)
    (complication-income-tax?       symbol)
    (complication-mirror?           symbol)
    (complication-no-double-jump?   symbol)
    (complication-unbreakable?      symbol)
    (complication-get-a-grip?       symbol)
    (complication-fast-reel?        symbol)
    (complication-palate-change?    symbol)
    (complication-jak-be-nimble?    symbol)
    (complication-soul-bond?        symbol)
    (complication-shifty?           symbol)
    (complication-interference?     symbol)
    (complication-quicksand?        symbol)
    (complication-lights-out?       symbol)
    (complication-half-price?       symbol)
    (complication-energy-boost?     symbol)
    
    ;; Punishments
    (punishment-fall-damage?        symbol)
    (punishment-trip?               symbol)
    (punishment-edge?               symbol)
    (punishment-money?              symbol)
    (punishment-warp?               symbol)
    (punishment-revert-cell?        symbol)
    (punishment-extra-rule?         symbol)
    (punishment-crash?              symbol)
    (punishment-delay?              symbol)
    (punishment-blind?              symbol)
    (punishment-iframes?            symbol)
    (punishment-camera?             symbol)
    (punishment-ohko?               symbol)
    (punishment-reset?              symbol)
    (punishment-countdown?          symbol)
    (punishment-kick?               symbol)
    (punishment-pause?              symbol)   

    ;; Timer options
    (countdown-start-seconds        float)
    (condition-delay-seconds        float)
    (time-limit-multiplier          float)
    (tier-1-increment-seconds       float)
    (tier-2-increment-seconds       float)
    (tier-3-increment-seconds       float)
    (pass-credits-required          int8)
    (compliance-increment-seconds   float)
    (show-countup-timer?            symbol)

    ;; other
    (difficulty                     symbol)
    (game-mode                      symbol)
    (text-scale                     float)
    (target-slot-count              int8)
  )
  (:methods
    (reset (_type_) int)
    ;; (commit-to-file (_type_) none)
