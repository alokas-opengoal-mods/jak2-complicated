(defun mod-rule-update-shifty ()
  (when (and (mod-rule-active? 'complication-shifty) (>= (current-time) (-> *MOD-rule-context-bank* shifty-next-time)))
    (when (and *target* (not (movie?)))
      (let ((dx (mod-rand-float-range 1.5 5.0))
            (dz (mod-rand-float-range 1.5 5.0))
            ;; (sfx (mod-rand-int-range 0 3))
            )
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dx (- dx)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dz (- dz)))
        (set! (-> (target-pos 0) x) (+ (-> (target-pos 0) x) (meters dx)))
        (set! (-> (target-pos 0) z) (+ (-> (target-pos 0) z) (meters dz)))
        (case (mod-rand-int-range 0 3)
          ((0) (play-custom-sfx sound-warp1 60.0))
          ((1) (play-custom-sfx sound-warp2 60.0))
          ((2) (play-custom-sfx sound-warp3 60.0))
          )))
    (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 11)))))
  (none))

