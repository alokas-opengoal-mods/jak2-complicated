      (if (mod-target-on-mode? 'racer) (target-attack-up *target* 'attack 'explode))))
  (none))

(defun global-countdown-paused? ()
  (or (movie?)
      ;; (task-complete? *game-info* (game-task finalboss-movies))
      (and *setting-control* (-> *setting-control* user-current movie))
      ;; (and *target* (logtest? (-> *target* state-flags) (state-flags grabbed)))
      (and *target* (logtest? (-> *target* focus-status) (focus-status grabbed)))
      )
  )

;; Step a value until it differs from the answer and the other two options.
(defun mod-trivia-dynamic-dedup ((val int) (answer int) (other1 int) (other2 int) (step int))
  (while (or (= val answer) (= val other1) (= val other2))
    (set! val (+ val step)))
  val)

;; Add or subtract mag from base (flips to add if the result would go negative).
(defun mod-trivia-dynamic-delta ((base int) (mag int) (sign int))
  (if (= sign 0) (if (>= (- base mag) 0) (- base mag) (+ base mag)) (+ base mag)))

;; Derive a wrong-answer value from the seed bits.
(defun mod-trivia-dynamic-offset ((base int) (seed int) (shift int) (step int) (count int))
  (let* ((bits (shr seed shift))
         (mag (* step (+ 1 (mod (logand bits 7) count))))
         (sign (logand (shr bits 3) 1)))
    (mod-trivia-dynamic-delta base mag sign)))

;; Build the choice string for a dynamic question (orbs collected, rules broken, etc).
(defun mod-trivia-dynamic-choice-str ((answer int) (shuffled-idx int) (count int))
  (let* ((seed (-> *MOD-quiz-bank* trivia-dynamic-seed))
         (step-divisor 15)
         (scaled-step (if (<= (/ answer step-divisor) 0) 1 (/ answer step-divisor)))
         (v1 (mod-trivia-dynamic-offset answer seed 0 scaled-step count))
         (v2 (mod-trivia-dynamic-offset answer seed 4 scaled-step count))
         (v3 (mod-trivia-dynamic-offset answer seed 8 scaled-step count)))
    (set! v1 (mod-trivia-dynamic-dedup v1 answer answer answer scaled-step))
    (set! v2 (mod-trivia-dynamic-dedup v2 answer v1 v1 scaled-step))
    (set! v3 (mod-trivia-dynamic-dedup v3 answer v1 v2 scaled-step))
    (format (clear (-> *MOD-quiz-bank* trivia-dynamic-str))
            "~D"
            (cond
              ((= shuffled-idx 0) answer)
              ((= shuffled-idx 1) v1)
              ((= shuffled-idx 2) v2)
              (else v3)))
    (-> *MOD-quiz-bank* trivia-dynamic-str)))

(defun mod-get-trivia-choice-str ((q-idx int) (guess-idx int))
  (let ((shuffled-idx (-> (-> *MOD-quiz-bank* trivia-shuffle-map) guess-idx)))
    (cond
      ;; Dynamic questions here
      ;; ((= q-idx 9999) (mod-trivia-dynamic-choice-str (-> *game-info* total-deaths) shuffled-idx 4))
      ;; ((= q-idx 9999) (mod-trivia-dynamic-choice-str (the int (-> *game-info* money)) shuffled-idx 6))
      ((= q-idx 40) (mod-trivia-dynamic-choice-str (-> *MOD-stats-bank* rules-broken) shuffled-idx 4))
      ;; ((= q-idx 47) (mod-trivia-dynamic-choice-str (the int (-> *game-info* money-total)) shuffled-idx 6))
      (else (-> *mod-trivia-choices* (+ (* q-idx 4) shuffled-idx))))))

(defun mod-get-trivia-answer ((q-idx int))
  (case q-idx
    ((4) 2)
    ((7) 1)
    ((12) 3)
    ((13) 3)
    ((14) 2)
    ((17) 1)
    ((19) 3)
    ((23) 2)
    ((26) 1)
    ((35) 2)
    ;; Dynamic questions here
    (else 0)))

(defun mod-trivia-outcome ()
  (let ((guess (-> *MOD-quiz-bank* trivia-current-guess)))
    (if (and (>= guess 0)
             (= (-> (-> *MOD-quiz-bank* trivia-shuffle-map) guess)
                (mod-get-trivia-answer (-> *MOD-quiz-bank* trivia-current-question))))
      'success
      'failed)))

(defun mod-shuffle-trivia-choices ((q-idx int))
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 0) 0)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 1) 1)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 2) 2)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 3) 3)
  ;; Do not shuffle
  (when (and (!= q-idx 2)
             (!= q-idx 4)
             (!= q-idx 7)
             (!= q-idx 12)
             (!= q-idx 13)
             (!= q-idx 14)
             (!= q-idx 17)
             (!= q-idx 19)
             (!= q-idx 23)
             (!= q-idx 26)
             (!= q-idx 31)
             (!= q-idx 34)
             (!= q-idx 35))
    (dotimes (i 4)
      (let* ((j (mod-rand-int-range 0 (+ i 1)))
             (temp (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i)))
        (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i) (-> (-> *MOD-quiz-bank* trivia-shuffle-map) j))
        (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) j) temp))))
  (none))

(defun mod-trivia-handle-input ()
  (when (mod-rule-active? 'rule-trivia)
    (let ((q-idx (-> *MOD-quiz-bank* trivia-current-question)))
      (when (!= q-idx (-> *MOD-quiz-bank* trivia-last-tracked-question))
        (set! (-> *MOD-quiz-bank* trivia-last-tracked-question) q-idx)
        (mod-shuffle-trivia-choices q-idx)
        (set! (-> *MOD-quiz-bank* trivia-current-guess) -1)))
    (unless (mod-warp-gate-menu-open?)
      (when (or (cpad-pressed? 0 up) (cpad-pressed? 0 right))
        (cond
          ((< (-> *MOD-quiz-bank* trivia-current-guess) 0) (set! (-> *MOD-quiz-bank* trivia-current-guess) 0))
          ((>= (-> *MOD-quiz-bank* trivia-current-guess) 3) (set! (-> *MOD-quiz-bank* trivia-current-guess) 0))
          (else (+! (-> *MOD-quiz-bank* trivia-current-guess) 1)))
        (play-custom-sfx sound-generic-beep 100.0)
        )
      (when (or (cpad-pressed? 0 down) (cpad-pressed? 0 left))
        (cond
          ((<= (-> *MOD-quiz-bank* trivia-current-guess) 0) (set! (-> *MOD-quiz-bank* trivia-current-guess) 3))
          (else (-! (-> *MOD-quiz-bank* trivia-current-guess) 1)))
        (play-custom-sfx sound-generic-beep 100.0)
        )
      )
    (when (and (>= (-> *MOD-quiz-bank* trivia-current-guess) 0) (cpad-pressed? 0 l3))
      (let ((slot (mod-rule-find-active-slot 'rule-trivia)))
        (when (>= slot 0)
          (mod-rule-resolve! slot (mod-trivia-outcome) #t)))))
  (none))

(defun mod-update-trivia ()
  (mod-trivia-handle-input)
  (when (mod-rule-active? 'rule-trivia)
    (let ((slot (mod-rule-find-active-slot 'rule-trivia)))
      (when (and (>= slot 0) (<= (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time)) 0))
        (mod-rule-resolve! slot (mod-trivia-outcome) #t))))
  (none))

;; Push every timer forward by elapsed so paused time doesn't count.
(defun mod-shift-all-timers! ((elapsed time-frame))
  (dotimes (slot *mod-rule-slot-count*)
    (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
      (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) elapsed)))
    (when (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
      (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)
            (+ (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) elapsed))))
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (when (-> (-> *MOD-punishment-bank* timed-punishments) slot)
      (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot)
            (+ (-> (-> *MOD-punishment-bank* timed-end-times) slot) elapsed))
      (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot)
            (+ (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) elapsed))))
  (set! (-> *MOD-rule-context-bank* hang-time-air-start) (+ (-> *MOD-rule-context-bank* hang-time-air-start) elapsed))
  (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (+ (-> *MOD-rule-context-bank* get-a-grip-last-grab) elapsed))
  (set! (-> *MOD-rule-context-bank* bus-driver-activate-time)
        (+ (-> *MOD-rule-context-bank* bus-driver-activate-time) elapsed))
  (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (-> *MOD-rule-context-bank* shifty-next-time) elapsed))
  (none))

;; Main rule loop.
(defbehavior mod-rule-manager-proc process ()
  (when (not (-> *MOD-countdown-bank* lost?))
    (loop
      (let ((elapsed (- (current-time) (-> *MOD-rule-context-bank* last-update-time))))
        (when (or (< elapsed 0) (> elapsed (seconds 10)))
          (mod-shift-all-timers! elapsed)
          (set! elapsed 0)
          )
        (cond
          ((global-countdown-paused?)
            (when (> elapsed 0)
              (mod-shift-all-timers! elapsed)
              )
            (when (or (movie?) 
                      ;; (and *target* (logtest? (-> *target* state-flags) (state-flags grabbed)))
                      (and *target* (logtest? (-> *target* focus-status) (focus-status grabbed)))
                      )
              (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) (current-time))
              )
            (mod-math-quiz-handle-input)
            (mod-trivia-handle-input)
            (mod-rule-handle-pass-input)
            )
          (else
            ;; (+! (-> *MOD-countdown-bank* countup-timer) elapsed)
            (when (and (> (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
                        (>= (current-time) (-> *MOD-rule-context-bank* mean-look-clear-time)))
              (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
              (when *target*
                (logclear! (-> *target* mask) (process-mask sleep))
                )
              )
            (mod-update-timed-punishments)
            (mod-update-math-quiz)
            (mod-update-trivia)
            (mod-rule-update-hang-time)
            (mod-rule-update-red-light)
            (mod-rule-handle-pass-input)
            (mod-rule-update-shifty)
            ;; (mod-orb-hunt-update)
            (let ((target (mod-rule-target-slot-count)))
              (when (< target *mod-last-target-slot-count*)
                (mod-rule-trim-pending-to-target!)
                )
              (set! *mod-last-target-slot-count* target)
              )
            (mod-rule-compact-slots!)
            (mod-rule-fill-to-target!)
            (when (mod-rule-active? 'complication-get-a-grip)
              (when (>= (- (current-time) (-> *MOD-rule-context-bank* get-a-grip-last-grab)) 
                        (mod-apply-time-limit-multiplier (seconds 12)))
                (mod-kill-target! 'endlessfall)
                (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time))
                )
              )
            (when (mod-rule-active? 'complication-cumbersome)
              (mod-orb-weight-apply!)
              )
            (when (mod-rule-active? 'complication-drought)
              ;; (mod-rule-set-drought-platform-gravity! #t)
              )
            (when (mod-rule-low-res-should-apply?)
              (mod-rule-apply-low-res!)
              )
            (when (mod-rule-active? 'complication-lights-out)
              ;; (mod-rule-lights-out-activate!)
              )
            (dotimes (slot *mod-rule-slot-count*)
              (when (and (-> (-> *MOD-rule-slot-bank* active-slots) slot)
                         (>= (current-time) (-> (-> *MOD-rule-slot-bank* slot-end-times) slot)))
                (mod-rule-handle-slot-expiry slot)
                )
              )
            (dotimes (slot *mod-rule-slot-count*)
              (let ((pending-id (-> (-> *MOD-rule-slot-bank* pending-slots) slot)))
                (when (and (eq? pending-id 'mod-rule-pending-roll)
                            (> (mod-rule-target-slot-count) 0)
                            (mod-rule-roll-possible?))
                  (let* ((rolling-left (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time))))
                          (whole-second (the int (/ rolling-left (seconds 1)))))
                    (if (> whole-second 2)
                      (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) -1)
                      (when (and (>= whole-second 0) (!= whole-second (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot)))
                        (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) whole-second)
                        (play-custom-sfx sound-timer-beep 20.0)
                        )
                      )
                    )
                  )
                (when (and pending-id (>= (current-time) (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)))
                  (if (eq? pending-id 'mod-rule-pending-roll)
                    (let ((chosen (mod-rule-pick-weighted-id)))
                      (if chosen
                        (begin
                          (mod-rule-activate-slot slot chosen)
                          (mod-rule-record-roll! chosen)
                          )
                        (mod-rule-clear-slot slot)
                        )
                      )
                    (mod-rule-activate-slot slot pending-id)
                    )
                  )
                )
              )
            )
          )
        (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
        )
      (suspend)
      )
    )
  (none))

(defun mod-rule-spawn-manager ()
  (kill-by-name "mod-rule-manager" *active-pool*)
  (process-spawn-function process
    mod-rule-manager-proc
    :name "mod-rule-manager")
  (none))

(defun mod-rules-start ()
  (mod-rule-reroll-current #t)
  (mod-rule-spawn-manager)
  (none))

(defun mod-rules-resume ()
  (when (= (mod-rule-active-slot-count) 0)
    (mod-rule-reroll-current #t))
  (mod-rule-spawn-manager)
  (none))

;; First active slot at or after start-slot, or -1.
(defun mod-rule-nth-active-slot ((start-slot int))
  (let ((slot (max 0 start-slot)))
    (while (and (< slot *mod-rule-slot-count*) (not (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
      (+! slot 1))
    (if (< slot *mod-rule-slot-count*) slot -1)))

(define-extern mod-run-hud-draw (function (none)))

;; Countdown loop: advance timers and draw the HUD every frame.
(defbehavior mod-global-countdown-proc process ()
  (loop
    (when (and (-> *MOD-countdown-bank* active?) (not (-> *MOD-countdown-bank* lost?)))
      ;; The countup timer always runs
      (let ((up-elapsed (- (current-time) (-> *MOD-countdown-bank* countup-last-update-time))))
        ;; Detect save/load time-warp
        (when (or (< up-elapsed 0) (> up-elapsed (seconds 10)))
          (set! up-elapsed 0)
          )
        (when (> up-elapsed 0)
          (set! (-> *MOD-countdown-bank* countup-timer) (+ (-> *MOD-countdown-bank* countup-timer) up-elapsed))
          )
        (set! (-> *MOD-countdown-bank* countup-last-update-time) (current-time))
        )
      
      (cond
        ((or (global-countdown-paused?)
             (and *target*
                  (or (and (mod-rule-active? 'complication-eco-reserve) (= (-> *target* fact eco-type) (pickup-type eco-yellow)))
                      (and (mod-rule-active? 'complication-red-stop) (= (-> *target* fact eco-type) (pickup-type eco-red))))
                  (>= (-> *target* fact eco-level) 1.0)))
          (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
          )
        (else
          (let ((elapsed (- (current-time) (-> *MOD-countdown-bank* last-update-time))))
            ;; Detect save/load time-warp
            (when (or (< elapsed 0) (> elapsed (seconds 10)))
              (set! elapsed 0)
              )
            (when (> elapsed 0)
              (when (and *target*
                          (mod-rule-active? 'complication-quicksand)
                          (= (-> *target* control ground-pat material) (pat-material sand)))
                (set! elapsed (* elapsed 2))
                )
              (set! (-> *MOD-countdown-bank* remaining-time) (max 0 (- (-> *MOD-countdown-bank* remaining-time) elapsed)))
              )
            (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
            ;; Beep on second during the final 10 seconds
            (let ((whole-second (the int (/ (-> *MOD-countdown-bank* remaining-time) (seconds 1)))))
              (if (> whole-second 9)
                (set! (-> *MOD-countdown-bank* last-warn-second) -1)
                (when (and (>= whole-second 0) (!= whole-second (-> *MOD-countdown-bank* last-warn-second)))
                  (set! (-> *MOD-countdown-bank* last-warn-second) whole-second)
                  (play-custom-sfx sound-timer-warn 20.0)
                  )
                )
              )
            (when (<= (-> *MOD-countdown-bank* remaining-time) 0)
              (format #t "COUNTDOWN: lost triggered~%")
              (play-custom-sfx sound-green-light 100.0)
              (mod-reset-run-and-restart)
              )
            )
          )
        )
      )
    (mod-run-hud-draw)
    (suspend)
    )
  (none))

;; Full run reset!
(defun mod-run-reset ()
  (kill-by-name "global-countdown" *active-pool*)
  (kill-by-name "mod-rule-manager" *active-pool*)
  (mod-rules-reset)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (set! (-> *MOD-countdown-bank* lost?) #f)
  (set! (-> *MOD-countdown-bank* remaining-time)
        (the int (* (countdown-start-seconds-value) (the float TICKS_PER_SECOND)))) ;; global countdown start
  (set! (-> *MOD-countdown-bank* countup-timer) 0)
  (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
  (set! (-> *MOD-countdown-bank* countup-last-update-time) (current-time))
  (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
  (none))

(defun mod-rng-reset-state! ()
  (set! (-> *MOD-rng-bank* content-state) (the uint 1))
  (set! (-> *MOD-rng-bank* punish-state) (the uint 1))
  (set! (-> *MOD-rng-bank* seed-display) (the uint 0))
  (none))

(defun mod-rule-context-reset! ()
  (mod-rules-reset-core)
  (none))

(defun mod-slot-punishments-save-value ()
  (mod-pack-symbols (-> *MOD-rule-slot-bank* slot-punishments) *mod-punishment-ids* *mod-rule-slot-count*))

(defun mod-slot-punishments-resume-from-save ((val int))
  (dotimes (slot *mod-rule-slot-count*)
    (set! (-> (-> *MOD-rule-slot-bank* saved-punishments) slot)
          (mod-unpack-symbol (the uint val) slot *mod-punishment-ids*)))
  (none))

(defun mod-rule-pending-slots-save-value ()
  (let ((result (the uint 0))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let* ((pending (-> (-> *MOD-rule-slot-bank* pending-slots) slot))
             (idx (if pending (mod-rule-index-from-id pending) -1))
             (byte-val (cond
                         ((not pending) (the uint #xff))
                         ((eq? pending 'mod-rule-pending-roll) (the uint #xfe))
                         ((>= idx 0) (the uint idx))
                         (else (the uint #xff)))))
        (set! result (logior result (shl byte-val (* slot 8)))))
      (+! slot 1))
    (the int result)))

(defun mod-rule-pending-slots-resume-from-save ((val int))
  (let ((bits (the uint val))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let ((idx (the int (logand (shr bits (* slot 8)) (the uint #xff)))))
        (set! (-> (-> *MOD-rule-slot-bank* saved-pending) slot)
              (cond
                ((= idx #xfe) 'mod-rule-pending-roll)
                ((= idx #xff) #f)
                (else (mod-rule-id-from-index idx)))))
      (+! slot 1)))
  (none))

(defun mod-rule-pending-times-save-value ()
  (let ((result (the uint 0))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let ((remaining (if (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
                         (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time)))
                         0)))
        (set! result
              (logior result
                      (shl (the uint (min #x3ff (/ (+ remaining (+ MOD_TICKS_PER_TENTH -1)) MOD_TICKS_PER_TENTH))) (* slot 10)))))
      (+! slot 1))
    (the int result)))

(defun mod-rule-pending-times-resume-from-save ((val int))
  (let ((bits (the uint val))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (set! (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) slot) (the int (logand (shr bits (* slot 10)) (the uint #x3ff))))
      (+! slot 1)))
  (none))

(defun mod-rule-slot-progress-save-value ((group int))
  (let ((result (the uint 0))
        (start (* group 2))
        (offset 0))
    (while (< offset 2)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-slot-count*)
          (set! result
                (logior result (shl (the uint (min #xffff (max 0 (-> (-> *MOD-rule-slot-bank* slot-progress) slot)))) (* offset 16)))))
        (+! offset 1)))
    (the int result)))

(defun mod-rule-slot-progress-resume-from-save ((group int) (val int))
  (let ((bits (the uint val))
        (start (* group 2))
        (offset 0))
    (while (< offset 2)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-slot-count*)
          (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) (the int (logand (shr bits (* offset 16)) (the uint #xffff)))))
        (+! offset 1))))
  (none))

(defmacro def-save-index-pair (save-name resume-name base-save-fn base-resume-fn index)
  `(begin
    (defun ,save-name ()
      (,base-save-fn ,index))
    (defun ,resume-name ((val int))
      (,base-resume-fn ,index val))))

(def-save-index-pair mod-rule-slot-progress0-save-value
                     mod-rule-slot-progress0-resume-from-save
                     mod-rule-slot-progress-save-value
                     mod-rule-slot-progress-resume-from-save
                     0)

(def-save-index-pair mod-rule-slot-progress1-save-value
                     mod-rule-slot-progress1-resume-from-save
                     mod-rule-slot-progress-save-value
                     mod-rule-slot-progress-resume-from-save
                     1)

(def-save-index-pair mod-rule-slot-progress2-save-value
                     mod-rule-slot-progress2-resume-from-save
                     mod-rule-slot-progress-save-value
                     mod-rule-slot-progress-resume-from-save
                     2)

(defun mod-math-quiz-state-save-value ()
  (the int
       (logior (the uint (-> *MOD-quiz-bank* math-val1))
               (shl (the uint (-> *MOD-quiz-bank* math-val2)) 8)
               (shl (the uint (-> *MOD-quiz-bank* math-op)) 16))))

(defun mod-math-quiz-state-resume-from-save ((val int))
  (let ((bits (the uint val)))
    (set! (-> *MOD-quiz-bank* math-val1) (the int (logand bits (the uint #xff))))
    (set! (-> *MOD-quiz-bank* math-val2) (the int (logand (shr bits 8) (the uint #xff))))
    (set! (-> *MOD-quiz-bank* math-op) (the int (logand (shr bits 16) (the uint #x3))))
    (mod-math-quiz-compute-answer!))
  (none))

(def-save-field-pair mod-math-quiz-guess-save-value
                     mod-math-quiz-guess-resume-from-save
                     (-> *MOD-quiz-bank* math-current-guess))

(defun mod-trivia-state-save-value ()
  (the int
       (logior (the uint (-> *MOD-quiz-bank* trivia-current-question))
               (shl (the uint (+ (-> *MOD-quiz-bank* trivia-current-guess) 1)) 8)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 0)) 11)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 1)) 13)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 2)) 15)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 3)) 17)
               (shl (the uint (-> *MOD-quiz-bank* trivia-dynamic-seed)) 19))))

(defun mod-trivia-state-resume-from-save ((val int))
  (let ((bits (the uint val)))
    (set! (-> *MOD-quiz-bank* trivia-current-question) (the int (logand bits (the uint #xff))))
    (set! (-> *MOD-quiz-bank* trivia-current-guess) (- (the int (logand (shr bits 8) (the uint #x7))) 1))
    (dotimes (i 4)
      (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i) (the int (logand (shr bits (+ 11 (* i 2))) (the uint #x3)))))
    (set! (-> *MOD-quiz-bank* trivia-dynamic-seed) (the int (logand (shr bits 19) (the uint #xfff))))
    (set! (-> *MOD-quiz-bank* trivia-last-tracked-question) (-> *MOD-quiz-bank* trivia-current-question)))
  (none))

(def-save-field-pair mod-rule-qte-state-save-value
                     mod-rule-qte-state-resume-from-save
                     (-> *MOD-rule-context-bank* qte-target-button))

(defun mod-timed-punishments-save-value ()
  (mod-pack-symbols (-> *MOD-punishment-bank* timed-punishments) *mod-punishment-ids* *mod-timed-punishment-slot-count*))

(defun mod-timed-punishment-times-save-value ((group int))
  (let ((result (the uint 0))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-timed-punishment-slot-count*)
          (let ((remaining (if (-> (-> *MOD-punishment-bank* timed-punishments) slot)
                             (max 0 (- (-> (-> *MOD-punishment-bank* timed-end-times) slot) (current-time)))
                             0)))
            (set! result
                  (logior result
                          (shl (the uint (min #xffff (/ (+ remaining (+ MOD_TICKS_PER_TENTH -1)) MOD_TICKS_PER_TENTH))) (* offset 16)))))))
      (+! offset 1))
    (the int result)))

(defun mod-timed-punishments-resume-from-save ((val int))
  (let* ((bits (the uint val))
         (legacy? (zero? (shr bits 32)))
         (empty-val (if legacy? #xf #xff))
         (slot 0))
    (while (< slot *mod-timed-punishment-slot-count*)
      (let ((idx (if legacy? (the int (logand (shr bits (* slot 4)) (the uint #xf))) (the int (logand (shr bits (* slot 8)) (the uint #xff))))))
        (set! (-> (-> *MOD-punishment-bank* timed-saved-ids) slot) (if (= idx empty-val) #f (mod-punishment-id-from-index idx))))
      (+! slot 1)))
  (none))

(defun mod-timed-punishment-times-resume-from-save ((group int) (val int))
  (let ((bits (the uint val))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-timed-punishment-slot-count*)
          (set! (-> (-> *MOD-punishment-bank* timed-saved-tenths) slot)
                (the int (logand (shr bits (* offset 16)) (the uint #xffff)))))
        (+! offset 1))))
  (none))

(def-save-index-pair mod-rule-timed-punishment-times0-save-value
                     mod-rule-timed-punishment-times0-resume-from-save
                     mod-timed-punishment-times-save-value
                     mod-timed-punishment-times-resume-from-save
                     0)

(def-save-index-pair mod-rule-timed-punishment-times1-save-value
                     mod-rule-timed-punishment-times1-resume-from-save
                     mod-timed-punishment-times-save-value
                     mod-timed-punishment-times-resume-from-save
                     1)

(defun mod-rule-active-slots-save-value ()
  (mod-pack-symbols (-> *MOD-rule-slot-bank* active-slots) *mod-rule-ids* *mod-rule-slot-count*))

(defun mod-rule-slot-remaining-time-save-value ((slot int))
  (if (-> (-> *MOD-rule-slot-bank* active-slots) slot)
    (the int (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
    0))

(defun mod-rule-slot-remaining-time-resume-from-save ((slot int) (val int))
  (set! (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot) (max 0 val))
  (none))

(def-save-index-pair mod-rule-slot0-end-time-save-value
                     mod-rule-slot0-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     0)

(def-save-index-pair mod-rule-slot1-end-time-save-value
                     mod-rule-slot1-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     1)

(def-save-index-pair mod-rule-slot2-end-time-save-value
                     mod-rule-slot2-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     2)

(def-save-index-pair mod-rule-slot3-end-time-save-value
                     mod-rule-slot3-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     3)

(def-save-index-pair mod-rule-slot4-end-time-save-value
                     mod-rule-slot4-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     4)

(defun mod-finalize-resume-from-save ()
  (dotimes (slot *mod-rule-slot-count*)
    (let ((remaining (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot)))
      (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
        (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (current-time) (if (>= remaining 0) remaining 0)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot)
              (mod-rule-counter-goal (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (-> (-> *MOD-rule-slot-bank* saved-punishments) slot)))))
  (dotimes (slot *mod-rule-slot-count*)
    (let ((pending (-> (-> *MOD-rule-slot-bank* saved-pending) slot))
          (tenths (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) slot)))
      (when pending
        (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) pending)
        (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (+ (current-time) (* (max 0 tenths) MOD_TICKS_PER_TENTH)))
        (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) -1))))
  (mod-clear-all-timed-punishments)
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-punishment-bank* timed-saved-ids) slot))
          (tenths (-> (-> *MOD-punishment-bank* timed-saved-tenths) slot)))
      (when (and punishment (> tenths 0))
        (set! (-> (-> *MOD-punishment-bank* timed-punishments) slot) punishment)
        (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot) (+ (current-time) (* tenths MOD_TICKS_PER_TENTH)))
        (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))
        (case punishment
          (('punishment-blind) 
            (set-blackout-frames (* tenths MOD_TICKS_PER_TENTH))
            )
          (('punishment-fall-damage) 
            (mod-set-punished-fall-damage!)
            )
          (('punishment-delay) 
            ;; (input-delay-enable! #t (-> *MOD-tuning-bank* punishment-input-delay))
            )
          (('punishment-iframes) 
            (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 0))
            )
          )
        )
      )
    )
  (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
  ;; (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) (current-time))
  ;; (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time))
  (none))

(defun mod-rule-active-slots-resume-from-save ((val int))
  (dotimes (i *mod-rule-slot-count*)
    (mod-rule-deactivate-slot i))
  (dotimes (i *mod-rule-slot-count*)
    (let ((id (mod-unpack-symbol (the uint val) i *mod-rule-ids*)))
      (set! (-> (-> *MOD-rule-slot-bank* active-slots) i) id)
      (when id
        (mod-rule-reapply-slot-visual-effect id))))
  (none))

