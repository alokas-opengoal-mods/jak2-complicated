;; Integer avalanche hash; scrambles a uint into a well-mixed one.
(defun mod-rng-hash-u32 ((x uint))
  (set! x (logxor x (shr x 16)))
  (set! x (* x (the uint #x7feb352d)))
  (set! x (logxor x (shr x 15)))
  (set! x (* x (the uint #x846ca68b)))
  (set! x (logxor x (shr x 16)))
  x)

(defun mod-rng-random-seed ()
  (mod-rng-hash-u32 (the uint (current-time))))


;; TEMP FIX until the cpp code is committed
(defun mod-rng-active-seed ()
  ;; (let ((imgui-seed (the uint (complicated-get-seed))))
  (let ((imgui-seed (the uint (rand-vu-int-range 1000000000 9999999999))))
    (if (!= imgui-seed 0) 
      (logand imgui-seed (the uint #x7fffffff)) 
      (logand (mod-rng-random-seed) (the uint #x7fffffff))
      )
    )
  )

;; Derive the two RNG stream states (content and punishment) from one master seed. Never leaves a state at 0.
(defun mod-rng-seed-all! ((master-seed uint))
  (let ((content-hash (mod-rng-hash-u32 (+ master-seed (the uint 1))))
        (punish-hash (mod-rng-hash-u32 (+ master-seed (the uint 2)))))
    (set! (-> *MOD-rng-bank* content-state) (if (= content-hash 0) (the uint 1) content-hash))
    (set! (-> *MOD-rng-bank* punish-state) (if (= punish-hash 0) (the uint 1) punish-hash)))
  (none))

;; Advance the content RNG one xorshift32 step. Content (rule rolls, quizzes) and punishment use
;; separate streams so one can't disturb the other.
(defun mod-rng-content-next-u32 ()
  (let ((x (-> *MOD-rng-bank* content-state)))
    (set! x (logxor x (shl x 13)))
    (set! x (logxor x (shr x 17)))
    (set! x (logxor x (shl x 5)))
    (set! (-> *MOD-rng-bank* content-state) x)
    x))

(defun mod-rng-punish-next-u32 ()
  (let ((x (-> *MOD-rng-bank* punish-state)))
    (set! x (logxor x (shl x 13)))
    (set! x (logxor x (shr x 17)))
    (set! x (logxor x (shl x 5)))
    (set! (-> *MOD-rng-bank* punish-state) x)
    x))

(defun mod-rand-int-range ((lo int) (hi int))
  (let* ((bound (the uint (- hi lo)))
         (threshold (mod (- (the uint 0) bound) bound))
         (r (mod-rng-content-next-u32)))
    (while (< r threshold)
      (set! r (mod-rng-content-next-u32)))
    (+ lo (the int (mod r bound)))))

;; Same as mod-rand-int-range but uses the punishment stream.
(defun mod-rand-punish-int-range ((lo int) (hi int))
  (let* ((bound (the uint (- hi lo)))
         (threshold (mod (- (the uint 0) bound) bound))
         (r (mod-rng-punish-next-u32)))
    (while (< r threshold)
      (set! r (mod-rng-punish-next-u32)))
    (+ lo (the int (mod r bound)))))

(defun mod-rand-float-range ((lo float) (hi float))
  (let ((r (logand (mod-rng-content-next-u32) (the uint #x7fffffff))))
    (+ lo (* (- hi lo) (/ (the float r) 2147483648.0)))))

(defun mod-symbol-index ((ids (array symbol)) (id symbol))
  (let ((i 0)) (while (< i (-> ids length)) (when (= (-> ids i) id) (return i)) (+! i 1)) -1))

(defun mod-rule-find-active-slot ((id symbol))
  (mod-symbol-index (-> *MOD-rule-slot-bank* active-slots) id))

(defun mod-rule-active? ((id symbol))
  (>= (mod-rule-find-active-slot id) 0))

;; Bounds-checked array lookup; returns #f when idx is out of range.
(defun mod-symbol-at ((ids (array symbol)) (idx int))
  (if (and (>= idx 0) (< idx (-> ids length))) (-> ids idx) #f))

;; Pack one byte per entry (index into ids, #xff = empty) into a uint. Save format: do not change.
(defun mod-pack-symbols ((arr (array symbol)) (ids (array symbol)) (n int))
  (let ((result (the uint 0))
        (i 0))
    (while (< i n)
      (let* ((sym (-> arr i))
             (idx (if sym (mod-symbol-index ids sym) -1))
             (byte-val (if (>= idx 0) (the uint idx) (the uint #xff))))
        (set! result (logior result (shl byte-val (* i 8)))))
      (+! i 1))
    (the int result)))

;; Inverse of mod-pack-symbols for a single slot's byte.
(defun mod-unpack-symbol ((bits uint) (slot int) (ids (array symbol)))
  (mod-symbol-at ids (the int (logand (shr bits (* slot 8)) (the uint #xff)))))

(defun mod-rule-id-from-index ((idx int))
  (mod-symbol-at *mod-rule-ids* idx)
  )

(defun mod-rule-index-from-id ((id symbol))
  (mod-symbol-index *mod-rule-ids* id)
  )

(defun mod-punishment-index-from-id ((id symbol))
  (mod-symbol-index *mod-punishment-ids* id))

(defun mod-punishment-id-from-index ((idx int))
  (mod-symbol-at *mod-punishment-ids* idx))
  
(defun mod-seconds->ms ((secs float))
  (the int (+ 0.5 (* secs 1000.0))))

