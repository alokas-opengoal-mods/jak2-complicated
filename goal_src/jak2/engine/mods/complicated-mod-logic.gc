     (if (-> *MOD-orb-hunt-bank* level)
       (string-format "COLLECT THE HIDDEN ORB IN ~S." (mod-level-display-name (-> *MOD-orb-hunt-bank* level)))
       "COLLECT THE HIDDEN ORB IN THIS LEVEL."))
    (('rule-no-ledge) "DO NOT GRAB A LEDGE.")
    (else "NO DESCRIPTION AVAILABLE.")))

