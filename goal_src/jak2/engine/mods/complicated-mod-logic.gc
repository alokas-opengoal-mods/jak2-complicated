(defun mod-rule-update-qte ()
  (let ((slot (mod-rule-find-active-slot 'rule-qte)))
    (when (>= slot 0)
      (let ((pressed (cpad-pressed 0)))
        (when (logtest? pressed (pad-buttons triangle circle x square))
          (let ((hit? (case (-> *MOD-rule-context-bank* qte-target-button)
                        ((0) (logtest? pressed (pad-buttons triangle)))
                        ((1) (logtest? pressed (pad-buttons circle)))
                        ((2) (logtest? pressed (pad-buttons x)))
                        (else (logtest? pressed (pad-buttons square))))))
            (mod-rule-resolve! slot (if hit? 'success 'failed) #f))))))
  (none))

(defun mod-rule-update-red-light ()
  (when (mod-rule-active? 'rule-red-light)
    (let ((looking? (and *target* (= (-> *target* state name) 'target-look-around))))
      (when (or (and (not (or looking? (mod-target-on-mode? 'racer)))
                     (or (cpad-pressed? 0 circle) (cpad-pressed? 0 square) (cpad-pressed? 0 x)))
                (and (not looking?) (or (cpad-pressed? 0 l1) (cpad-pressed? 0 r1)))
                (!= (-> *cpad-list* cpads 0 stick0-speed) 0.0)
                (and (mod-target-on-mode? 'racer) (cpad-hold? 0 x)))
        (mod-rule-fail! 'rule-red-light))))
  (none))


