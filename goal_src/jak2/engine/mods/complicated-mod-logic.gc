(defun mod-rule-counter-goal ((id symbol))
  (case id
    (('rule-lurker-pressure) 6)
    (('rule-hitlist 'rule-sagging-sails 'rule-hang-time) 3)
    (('rule-crate-break) 5)
    (('rule-money-pressure) 20)
    (('rule-keep-rolling) 30)
    (('rule-double-kill 'rule-fuel-pressure
                       'rule-sniper
                       'rule-buzzer-pressure
                       'rule-die
                       'rule-one-frame
                       'rule-vendetta
                       'rule-for-billy
                       'rule-speed
                       'rule-green-pilled
                       'rule-button-pusher
                       'rule-loyal-customer
                       'rule-cooked
                       'rule-express-delivery
                       'rule-qte
                       'rule-touch-grass
                       'rule-supercharged
                       'rule-uncharted
                       'rule-bonecracker
                       'rule-orb-hunt)
     1)
    (else 0)))

