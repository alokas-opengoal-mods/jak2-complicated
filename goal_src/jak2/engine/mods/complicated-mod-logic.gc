(defun global-countdown-spawn-proc ()
  (kill-by-name "global-countdown" *active-pool*)
  (process-spawn-function process
    mod-global-countdown-proc
    :name "global-countdown")
  (none))

;; (defun mod-reset-level-visits! ()
;;   (dotimes (i (-> *game-info* enter-level-time length))
;;     (set! (-> *game-info* enter-level-time i) 0))
;;   (set-time! (-> *game-info* enter-level-time (level-task-data-index training)))
;;   (none))

;; Start a new run.
(defun mod-run-start ()
  ;; (mod-reset-level-visits!)
  (let ((active-seed (mod-rng-active-seed)))
    (mod-rng-seed-all! active-seed)
    (set! (-> *MOD-rng-bank* seed-display) active-seed)
    (format 0 "[mod-rng] seed: ~D~%" active-seed))
  (mod-run-reset)
  (set! (-> *MOD-countdown-bank* active?) #t)
  (mod-rules-start)
  (global-countdown-spawn-proc)
  (none))

(defun global-countdown-save-value ()
  (if (-> *MOD-countdown-bank* active?) (the int (-> *MOD-countdown-bank* remaining-time)) 0))

(defun global-countdown-resume-from-save ((saved-time int))
  (set! (-> *MOD-countdown-bank* saved-remaining-time) saved-time)
  (none))

(defun mod-run-finalize-resume-from-save ()
  (let ((saved-time (-> *MOD-countdown-bank* saved-remaining-time)))
    (set! (-> *MOD-countdown-bank* saved-remaining-time) -1)
    (if (-> *MOD-rule-context-bank* game-beaten?)
      ;; This save file already beat the game.
      (when (or (-> *MOD-countdown-bank* active?) (-> *MOD-countdown-bank* lost?))
        (mod-run-freeze-for-game-beaten))
      (cond
        ((> saved-time 0)
         (set! (-> *MOD-countdown-bank* remaining-time) saved-time)
         (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
         (set! (-> *MOD-countdown-bank* countup-last-update-time) (current-time))
         (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
         (set! (-> *MOD-countdown-bank* active?) #t)
         (set! (-> *MOD-countdown-bank* lost?) #f)
         (mod-rules-resume)
         (global-countdown-spawn-proc))
        (else
         ;; No countdown was saved in this file.
         (when (or (-> *MOD-countdown-bank* active?) (-> *MOD-countdown-bank* lost?))
           (mod-run-reset))))))
  (none))

(defun global-countup-save-value ()
  (if (-> *MOD-countdown-bank* active?) (the int (-> *MOD-countdown-bank* countup-timer)) 0))

(defun global-countup-resume-from-save ((saved-time int))
  (set! (-> *MOD-countdown-bank* countup-saved-time) saved-time)
  (none))

(defun global-countup-finalize-resume-from-save ()
  (when (and (not (-> *MOD-rule-context-bank* game-beaten?)) (> (-> *MOD-countdown-bank* countup-saved-time) 0))
    (set! (-> *MOD-countdown-bank* countup-timer) (-> *MOD-countdown-bank* countup-saved-time)))
  (set! (-> *MOD-countdown-bank* countup-saved-time) -1)
  (none))