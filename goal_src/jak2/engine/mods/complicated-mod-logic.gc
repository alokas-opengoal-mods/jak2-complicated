(defmacro def-save-field-pair (save-name resume-name place)
  `(begin
    (defun ,save-name ()
      ,place)
    (defun ,resume-name ((val int))
      (set! ,place val)
      (none)
      )
    )
  )


(defun punishment-toggle-enabled? ((punishment symbol))
  (the symbol
    (case punishment
      (('punishment-fall-damage) (-> *complicated-settings* punishment-fall-damage?))
      (('punishment-trip) (-> *complicated-settings* punishment-trip?))
      (('punishment-edge) (-> *complicated-settings* punishment-edge?))
      (('punishment-money) (-> *complicated-settings* punishment-money?))
      (('punishment-warp) (-> *complicated-settings* punishment-warp?))
      (('punishment-revert-cell) (-> *complicated-settings* punishment-revert-cell?))
      (('punishment-extra-rule) (-> *complicated-settings* punishment-extra-rule?))
      (('punishment-crash) (-> *complicated-settings* punishment-crash?))
      (('punishment-delay) (-> *complicated-settings* punishment-delay?))
      (('punishment-blind) (-> *complicated-settings* punishment-blind?))
      (('punishment-iframes) (-> *complicated-settings* punishment-iframes?))
      (('punishment-camera) (-> *complicated-settings* punishment-camera?))
      (('punishment-ohko) (-> *complicated-settings* punishment-ohko?))
      (('punishment-reset) (-> *complicated-settings* punishment-reset?))
      (('punishment-countdown) (-> *complicated-settings* punishment-countdown?))
      (('punishment-kick) (-> *complicated-settings* punishment-kick?))
      (('punishment-pause) (-> *complicated-settings* punishment-pause?))
      (else #t)
      )
    )
  )

