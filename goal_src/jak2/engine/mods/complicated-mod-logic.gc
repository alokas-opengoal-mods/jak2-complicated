(defun mod-game-beaten-resume-from-save ((value int))
  (set! (-> *MOD-rule-context-bank* game-beaten?) (not (= value 0)))
  (none))

(defun mod-game-beaten-save-value ()
  (if (-> *MOD-rule-context-bank* game-beaten?) 1 0))

(defun mod-game-beaten-set! ((val symbol))
  (set! (-> *MOD-rule-context-bank* game-beaten?) val)
  (none))

;; Called when the final light eco is picked up.
(defun mod-finalize-run-stats! ()
  (set! (-> *MOD-stats-bank* final-remaining-time) (-> *MOD-countdown-bank* remaining-time))
  (set! (-> *MOD-stats-bank* final-time) (-> *MOD-countdown-bank* countup-timer))
  ;; (set! (-> *MOD-stats-bank* final-score) (the int (mod-calc-run-score)))
  (none))

(defun mod-difficulty-display-name ()
  (let ((text (text-id null)))
    (set! text
      (case (-> *complicated-settings* difficulty)
        (('easy) (text-id mod-progress-difficulty-1))
        (('medium) (text-id mod-progress-difficulty-2))
        (('hard) (text-id mod-progress-difficulty-3))
        (('unfathomable) (text-id mod-progress-difficulty-4))
        (else (text-id mod-custom))
        )
      )
    (string-format (lookup-text! *common-text* text #f))
    )
  )

