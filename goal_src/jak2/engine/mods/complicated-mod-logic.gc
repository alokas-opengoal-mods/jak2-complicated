(defun mod-invisible-man-restore! ()
  (when *target*
    ;; (mod-target-mesh-invis-set! #f)
    (set-vector! (-> *target* draw color-mult) 1.0 1.0 1.0 1.0)
    (send-event *target* 'sidekick #t)
    (let ((v1-9 (-> *target* draw shadow-ctrl))) (logclear! (-> v1-9 settings flags) (shadow-flags disable-draw))))
  (none))

;; True if an active slot already has this punishment assigned.
(defun mod-punishment-used-by-active-slot? ((punishment symbol))
  (let ((slot 0)
        (used #f))
    (while (and (< slot *mod-rule-slot-count*) (not used))
      (when (and (-> (-> *MOD-rule-slot-bank* active-slots) slot)
                 (eq? (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) punishment))
        (set! used #t))
      (+! slot 1))
    used))

(defun mod-punishment-rollable? ((punishment symbol))
  ;; reset and time loss have no lingering state, so several slots may hold them at once
  (and (not (mod-timed-punishment-active? punishment))
       (or (eq? punishment 'punishment-reset)
           (eq? punishment 'punishment-countdown)
           (not (mod-punishment-used-by-active-slot? punishment)))))

(defmacro consider-punishment (sym weight &rest conds)
  `(when (and ,@conds (punishment-toggle-enabled? ',sym) (mod-punishment-rollable? ',sym))
    (let ((w ,weight)) 
      (+! running-total w)
      (when (< (mod-rand-punish-int-range 0 running-total) w) 
        (set! selected ',sym)
        )
      )
    )
  )

;; Defaults to time loss if nothing else is chosen.
(defun mod-random-available-punishment ((rule-id symbol))
  (let ((selected 'punishment-countdown)
        (running-total 0))
    (consider-punishment punishment-countdown
                         10
                         (not (or (eq? rule-id 'rule-for-billy)
                                  (eq? rule-id 'rule-orb-hunt)
                                  (and (eq? rule-id 'rule-sniper) (eq? (current-level-name) 'beach)))))
    (consider-punishment punishment-fall-damage
                         10
                         (not (or (eq? (current-level-name) 'finalboss) (mod-target-on-racer-or-flut?))))
    (consider-punishment punishment-trip 10 (not (mod-target-on-racer-or-flut?)))
    (consider-punishment punishment-edge 10 (not (eq? (current-level-name) 'finalboss)) (not (mod-target-on-racer-or-flut?)))
    (consider-punishment punishment-money
                         (if (>= (current-cell-count) 72) 5 10)
                         (>= (current-orb-count) (-> *MOD-tuning-bank* money-punishment-min-orbs))
                         (not (or (eq? (current-level-name) 'citadel) (eq? (current-level-name) 'finalboss) (eq? (current-level-name) 'lavatube))))
    (consider-punishment punishment-warp 8 (!= (-> (level-get-target-inside *level*) name) 'training))
    ;; (consider-punishment punishment-revert-cell
    ;;                      7
    ;;                      (mod-can-revert-collected-cell?)
    ;;                      (not (and (or (eq? (current-level-name) 'lavatube) (eq? (current-level-name) 'citadel) (eq? (current-level-name) 'finalboss))
    ;;                                (< (current-cell-count) 90))))
    (consider-punishment punishment-extra-rule 10 (<= (+ (mod-rule-active-slot-count) 2) *mod-rule-slot-count*))
    (consider-punishment punishment-crash 6 (not (eq? rule-id 'rule-qte)))
    (consider-punishment punishment-delay 10 (not (mod-rule-active? 'complication-bad-ping)))
    (consider-punishment punishment-blind 10)
    (consider-punishment punishment-iframes 10)
    (consider-punishment punishment-camera 10)
    (consider-punishment punishment-kick 10)
    (consider-punishment punishment-ohko 10)
    (consider-punishment punishment-pause 10)
    (consider-punishment punishment-reset 3 (not (eq? rule-id 'rule-qte)))
    selected))

