;;-*-Lisp-*-
(in-package goal)

;; name: complicated-mod-rule-lifecycle.gc
;; name in dgo: complicated-mod-rule-lifecycle
;; dgos: TODO


;; Mark a slot as pending a new roll. A pending roll is only scheduled when something can roll.
(defun mod-rule-schedule-slot ((slot int) (id symbol) (apply-buffer symbol))
  (when (and (> (mod-rule-target-slot-count) 0)
             (>= slot 0)
             (< slot *mod-rule-slot-count*)
             id
             (or (not (eq? id 'mod-rule-pending-roll)) (mod-rule-roll-possible?)))
    (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) id)
    (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)
          (+ (current-time) (if apply-buffer (the time-frame (* (the float TICKS_PER_SECOND) (new-condition-delay-seconds))) 0))))
  (none))

;; Schedule rolls into free slots until the target count is reached.
(defun mod-rule-fill-to-target! ()
  (dotimes (i *mod-rule-slot-count*)
    (let ((free (mod-rule-first-free-slot)))
      (when (and (>= free 0) (< (mod-rule-active-slot-count) (mod-rule-target-slot-count)))
        (mod-rule-schedule-slot free 'mod-rule-pending-roll #t))))
  (none))

;; ID of the first active slot.
(defun mod-rule-current-active-id ()
  (let ((slot 0)
        (found #f)
        (result #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((candidate (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when candidate
          (set! result candidate)
          (set! found #t)))
      (+! slot 1))
    result))


(defun mod-target-mesh-invis-set! ((enabled? symbol))
  (when *target*
    (if enabled?
      (begin
        (logior! (-> *target* draw status) (draw-control-status no-draw-bounds2))
        (logior! (-> *target* draw shadow-ctrl settings flags) (shadow-flags disable-draw))
        (logior! (-> *gun-shadow-control* settings flags) (shadow-flags disable-draw))
        (logior! (-> *board-shadow-control* settings flags) (shadow-flags disable-draw))
        (logclear! (-> *game-info* features) (game-feature sidekick))
        )
      (begin
        (logclear! (-> *target* draw status) (draw-control-status no-draw-bounds2))
        (logclear! (-> *target* draw shadow-ctrl settings flags) (shadow-flags disable-draw))
        (logclear! (-> *gun-shadow-control* settings flags) (shadow-flags disable-draw))
        (logclear! (-> *board-shadow-control* settings flags) (shadow-flags disable-draw))
        (logior! (-> *game-info* features) (game-feature sidekick))
        )
      )
    )
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; complication-lights-out
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; One backup per regular level slot.
(deftype mod-mood-backups (structure)
  ((context       mood-context LEVEL_MAX :inline)
   (func          (function mood-context float int none) LEVEL_MAX)
   (level-name    symbol LEVEL_MAX)
   (saved?        symbol LEVEL_MAX))
  )

(define *MOD-mood-backups*
  (new 'static 'mod-mood-backups)
  )

(define *MOD-lights-out-tie-envmap-mask*
  (vu1-renderer-mask 
    tie-envmap 
    tie-envmap-scissor 
    tie-envmap-trans
    tie-envmap-scissor-trans 
    tie-envmap-water 
    tie-envmap-scissor-water
    )
  )

(define *MOD-lights-out-saved-tie-envmap-mask* (the-as vu1-renderer-mask 0))

(defun mod-lights-out! ((enabled? symbol))
  (when (and enabled? (not (-> *MOD-lights-out-bank* active?)))
    (set! *MOD-lights-out-saved-tie-envmap-mask*
          (logand (-> *display* vu1-enable-user) *MOD-lights-out-tie-envmap-mask*))
    )
  (if enabled?
      (logclear! (-> *display* vu1-enable-user) *MOD-lights-out-tie-envmap-mask*)
      (when (-> *MOD-lights-out-bank* active?)
        (logclear! (-> *display* vu1-enable-user) *MOD-lights-out-tie-envmap-mask*)
        (logior! (-> *display* vu1-enable-user) *MOD-lights-out-saved-tie-envmap-mask*)
        )
      )
  (set! *lights-out-disable-render-effects?* enabled?)
  (dotimes (i LEVEL_MAX)
    (let ((lev (-> *level* level i)))
      (if enabled?
          (when (and (or (= (-> lev status) 'active)
                         (= (-> lev status) 'loaded))
                     (not (-> *MOD-mood-backups* saved? i)))
            (mem-copy! (the-as pointer (-> *MOD-mood-backups* context i))
                       (the-as pointer (-> lev mood-context))
                       1968)
            (set! (-> *MOD-mood-backups* func i) (-> lev mood-func))
            (set! (-> *MOD-mood-backups* level-name i) (-> lev name))
            (set! (-> *MOD-mood-backups* saved? i) #t)
            (set! (-> lev mood-func)
                  (the-as (function mood-context float int none) update-mood-lights-out))
            )
          (when (-> *MOD-mood-backups* saved? i)
            (when (and (= (-> lev name) (-> *MOD-mood-backups* level-name i))
                       (or (= (-> lev status) 'active)
                           (= (-> lev status) 'loaded)))
              (mem-copy! (the-as pointer (-> lev mood-context))
                         (the-as pointer (-> *MOD-mood-backups* context i))
                         1968)
              (set! (-> lev mood-func) (-> *MOD-mood-backups* func i))
              )
            (set! (-> *MOD-mood-backups* saved? i) #f)
            )
          )
      )
    )
  (set! (-> *MOD-lights-out-bank* active?) enabled?)
  (none)
  )

(defun mod-rule-update-lights-out ()
  "Refreshes the effect on the active level pool"
  (when (mod-rule-active? 'complication-lights-out)
    (mod-lights-out! #f)
    (mod-lights-out! #t)
    )
  (none)
  )




(defun mod-level-loaded? ((level-name symbol))
  (let ((result #f))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev name) level-name) (or (= (-> lev status) 'active) (= (-> lev status) 'loaded)))
          (set! result #t))))
    result))

(defmacro mod-set-platform-gravity! (level-name constants factor)
  `(when (and (mod-level-loaded? ,level-name) ,constants (nonzero? ,constants))
    (set! (-> ,constants gravity-factor) ,factor)))

