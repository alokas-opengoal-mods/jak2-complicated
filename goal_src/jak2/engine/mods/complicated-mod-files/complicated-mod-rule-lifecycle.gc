(defun mod-set-jump-heights ((mult float))
  (set! (-> *TARGET-bank* jump-height-min) (* (meters 1.01) mult))
  (set! (-> *TARGET-bank* jump-height-max) (* (meters 3.5) mult))
  (set! (-> *TARGET-bank* double-jump-height-min) (* (meters 1) mult))
  (set! (-> *TARGET-bank* double-jump-height-max) (* (meters 2.5) mult))
  (set! (-> *TARGET-bank* flip-jump-height-min) (* (meters 5) mult))
  (set! (-> *TARGET-bank* flip-jump-height-max) (* (meters 7) mult))
  (set! (-> *TARGET-bank* duck-jump-height-min) (* (meters 5) mult))
  (set! (-> *TARGET-bank* duck-jump-height-max) (* (meters 7) mult))
  (set! (-> *TARGET-bank* flop-jump-height-min) (* (meters 5) mult))
  (set! (-> *TARGET-bank* flop-jump-height-max) (* (meters 7) mult))
  (set! (-> *TARGET-bank* swim-jump-height-min) (* (meters 5) mult))
  (set! (-> *TARGET-bank* swim-jump-height-max) (* (meters 5) mult))
  (set! (-> *TARGET-bank* tube-jump-height-min) (* (meters 1.75) mult))
  (set! (-> *TARGET-bank* tube-jump-height-max) (* (meters 2.5) mult))
  (set! (-> *TARGET-bank* carry-jump-height-min) (* (meters 1.75) mult))
  (set! (-> *TARGET-bank* carry-jump-height-max) (* (meters 2) mult))
  (set! (-> *TARGET-bank* mech-jump-height-min) (* (meters 1.5) mult))
  (set! (-> *TARGET-bank* mech-jump-height-max) (* (meters 1.5) mult))
  (set! (-> *TARGET-bank* indax-jump-height-min) (* (meters 1.01) mult))
  (set! (-> *TARGET-bank* indax-jump-height-max) (* (meters 3.5) mult))
  (set! (-> *TARGET-bank* indax-double-jump-height-min) (* (meters 1) mult))
  (set! (-> *TARGET-bank* indax-double-jump-height-max) (* (meters 2.5) mult))
  (set! (-> *TARGET_BOARD-bank* jump-height-min) (* (meters 1.01) mult))
  (set! (-> *TARGET_BOARD-bank* jump-height-max) (* (meters 3.5) mult))
  (set! (-> *TARGET_BOARD-bank* duck-jump-height-min) (* (meters 2.5) mult))
  (set! (-> *TARGET_BOARD-bank* duck-jump-height-max) (* (meters 5) mult))
  (set! (-> *TARGET_BOARD-bank* trickx-jump-height-min) (* (meters 0.9) mult))
  (set! (-> *TARGET_BOARD-bank* trickx-jump-height-max) (* (meters 1.2) mult))
  (set! (-> *TARGET_BOARD-bank* tricky-jump-height-min) (* (meters 0.9) mult))
  (set! (-> *TARGET_BOARD-bank* tricky-jump-height-max) (* (meters 1.2) mult))
  (none)
  )


(defun mod-reset-cam-settings ()
  (logclear! (-> *target* draw status) (draw-control-status no-draw-bounds2))
  (logior! (-> *game-info* features) (game-feature sidekick))
  (remove-setting-by-arg0 *setting-control* 'mode-name)
  (remove-setting-by-arg0 *setting-control* 'fov)
  (remove-setting-by-arg0 *setting-control* 'slave-options)
  (none)
  )


;; Apply or re-apply the one-time effect of a condition.
(defun mod-rule-reapply-slot-visual-effect ((id symbol))
  (case id
    (('complication-mirror) 
      (logior! (-> *game-info* secrets) (game-secrets hflip-screen))
      )
    ;; (('complication-hidden-treasure) 
    ;;   (mod-refresh-money-actors #f)
    ;;   )
    (('complication-drought) 
      ;; (mod-rule-set-drought-platform-gravity! #t)
      )
    (('complication-cumbersome) 
      (mod-orb-weight-apply!)
      )
    (('complication-interference) 
      (when (mod-rule-low-res-should-apply?) (mod-rule-apply-low-res!))
      )
    (('complication-invisible-man)
      (mod-target-mesh-invis-set! #t)
      )
    (('complication-bad-ping) 
      ;; (input-delay-enable! #t (-> *MOD-tuning-bank* bad-ping-input-delay))
      )
    (('complication-lights-out)
      (mod-lights-out! #t)
      )
    (('complication-jak-rabbit)
      (mod-set-jump-heights 2.0)
      )
    (('complication-jak-be-nimble)
      (mod-refresh-movement-speeds! #t (if (mod-rule-active? 'complication-cumbersome) (mod-orb-weight-multiplier) 1.0))
      (set! (-> *high-jump-mods* target-speed) 77777.0)
      (set! (-> *smack-jump-mods* target-speed) 77777.0)
      (set! (-> *flop-mods* target-speed) 77777.0)
      (set! (-> *stone-surface* target-speed) 1.25)
      )
    (('complication-joyride) 
      (send-event *target* 'change-mode 'flut #f)
      )
    (('complication-shifty)
      (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 9))))
      )
    (('complication-sidekicked)
      (send-event *target* 'change-mode 'normal #f)
      (send-event *target* 'change-mode 'indax #f)
      )
    (('complication-fast-target)
      (update-rates! (-> *display* target-clock) 2.0)
      )
    (('complication-fast-entities)
      (update-rates! (-> *display* entity-clock) 2.0)
      (update-rates! (-> *display* part-clock) 2.0)
      )
    (('complication-slow-target)
      (update-rates! (-> *display* target-clock) 0.5)
      )
    (('complication-slow-entities)
      (update-rates! (-> *display* entity-clock) 0.3)
      (update-rates! (-> *display* part-clock) 0.3)
      )
    (('complication-iron-man)
      (send-event *target* 'change-mode 'mech #f)
      )
    (('complication-pov)
      ;; (set-setting-by-param *setting-control* 'mode-name (-> cam-eye name) 0 0)
      ;; (logior! (-> *target* draw status) (draw-control-status no-draw-bounds2))
      ;; (logclear! (-> *game-info* features) (game-feature sidekick))
      ;; (set-setting-by-param *setting-control* 'fov #f (* 182.04445 100) 0)
      ;; ;; Fuckass hack to make sure it sets the fov
      ;; (process-spawn-function process
      ;;   (lambda ()
      ;;     (until (= (-> *camera* slave 0 fov) (* 182.04445 100))
      ;;       (set! (-> *camera* slave 0 fov) (* 182.04445 100))
      ;;       (suspend)
      ;;       )
      ;;     )
      ;;   )
      )
    (else (none))
    )
  (none))

