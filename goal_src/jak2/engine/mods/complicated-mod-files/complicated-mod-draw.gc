(defun mod-rule-draw-labeled-value! ((label string) (height int) (label-color font-color) (value string) (row int))
  ;; (mod-draw-string-xy-scaled label buf 10 row label-color (mod-hud-flags) 0.3)
  (let ((text-scale 0.3)
        (text-box-height height)
        )
    (set! text-scale 0.3)
    (set! text-box-height (mod-text-box-relative-height text-scale 1))
    ;; Draw label
    (mod-draw-text 
      label
      *mod-hud-x*
      row
      *mod-hud-slot-width*
      text-box-height
      label-color
      (mod-hud-flags)
      text-scale
      )
    ;; Draw value
    (set! text-scale 0.4)
    (mod-draw-text
      value
      (+ *mod-hud-x* (mod-scale-px 70))
      (- row (mod-scale-px 2))
      *mod-hud-slot-width*
      text-box-height
      label-color
      (mod-hud-flags)
      text-scale
      )
    )
  )


;; Draw one slot's HUD block: name, description, punishment, progress, timer,
;; pass hint, plus extras for some rules (distance, last kill, etc).
(defun mod-rule-desc-essential? ((id symbol))
  (or (eq? id 'rule-qte) (eq? id 'complication-twisted)))


(defun mod-rule-draw-slot ((slot int) (y int) (compact? symbol))
  (let* ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot))
         (punishment (-> (-> *MOD-rule-slot-bank* slot-punishments) slot))
         (goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
         (progress (-> (-> *MOD-rule-slot-bank* slot-progress) slot))
         (time-left (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
         (row y)
         (text-box-height 20)
         (text-scale 0.5)
         (rule-idx (mod-rule-index-from-id id))
        ;;  (rule-name (text-id->string (-> *mod-rules* rule-idx name-text)))
        ;;  (rule-desc (text-id->string (-> *mod-rules* rule-idx desc-text)))
         (rule-name (mod-rule-name id))
         (rule-desc (mod-rule-description id))
        ;;  (show-progress? (-> (mod-rule-info-get id) progress?))
         )

    ;; Draw rule name
    (set! text-scale 0.5)
    (set! text-box-height (mod-text-box-relative-height text-scale 1))
    (mod-draw-text
      rule-name
      *mod-hud-x*
      row
      *mod-hud-slot-width*
      text-box-height
      (case (mod-rule-type id)
        (('rule) (font-color orange))
        (('complication) (font-color cyan))
        (else (font-color white))
        )
      (mod-hud-flags)
      text-scale
      )
    (+! row (mod-scale-px text-box-height))
    
    ;; Draw rule description
    (when (or (not compact?) 
              (mod-rule-desc-essential? id)
              )
      ;; (if (eq? id 'rule-qte)
      ;;   (begin
      ;;     (mod-draw-string-xy-scaled 
      ;;       rule-desc 
      ;;       buf 
      ;;       10 
      ;;       row 
      ;;       (font-color white) 
      ;;       (mod-hud-flags) 
      ;;       0.35
      ;;       )
      ;;     (mod-draw-qte-button buf (mod-scale-px 50) row)
      ;;     (+! row (mod-scale-px 20))
      ;;     )
      ;;   (set! row (mod-rule-draw-wrapped! buf id rule-desc 25 10 row 0.35 9))
      ;;   )
      (set! text-scale 0.35)
      (set! text-box-height (mod-text-box-relative-height text-scale 2))
      (mod-draw-text
        rule-desc
        *mod-hud-x*
        row
        *mod-hud-slot-width*
        text-box-height
        (font-color white)
        (mod-hud-flags)
        text-scale
        )
      (+! row (mod-scale-px text-box-height))
      )

    ;; Draw punishment header
    (when punishment
      (set! text-scale 0.3)
      (set! text-box-height (mod-text-box-relative-height text-scale 1))
      ;; Draw label
      (mod-draw-text
        (text-id->string (text-id mod-hud-punishment))
        *mod-hud-x*
        row
        *mod-hud-slot-width*
        text-box-height
        (font-color red)
        (mod-hud-flags)
        text-scale
        )
      ;; (+! row (mod-scale-px text-box-height))

      ;; Draw punishment description
      (set! text-box-height (mod-text-box-relative-height text-scale 2))
      (let ((label (-> (mod-punishment-info-get punishment) desc-text))
            (duration (-> (mod-punishment-info-get punishment) duration))
            )
        (mod-draw-text
          (if (-> (mod-punishment-info-get id) timed?)
            (string-format (text-id->string label)
              (mod-duration-amount duration)
              )
            (text-id->string label)
            )
          (+ *mod-hud-x* (mod-scale-px 70))
          row
          (the int (* 0.8 *mod-hud-slot-width*))
          text-box-height
          (font-color red)
          (mod-hud-flags)
          text-scale
          )
          (+! row (mod-scale-px text-box-height))
        )
      )

    ;; Draw rule progress counters
    (case id
      (('rule-hang-time 
        'rule-distancing 
        'rule-sniper
        'complication-bus-driver
        'rule-speed
        'complication-get-a-grip
        )
      (set! text-scale 0.3)
      (set! text-box-height (mod-text-box-relative-height text-scale 1))
      (let ((label (text-id null))
            (value "")
            )
        ;; Set rule progress params
        (case id
          (('rule-hang-time) 
            (set! label (text-id mod-hud-progress))
            (let* ((elapsed (min (seconds (mod-rule-counter-goal 'rule-hang-time)) (- (current-time) (-> *MOD-rule-context-bank* hang-time-air-start))))
                     (tenths (the int (* (/ (the float elapsed) (the float (seconds 1))) 10)))
                     )
              (set! value (string-format "~D.~D/~D" (/ tenths 10) (mod tenths 10) goal))
              )
            )
          (('rule-distancing) 
            (set! label (text-id mod-hud-distance))
            (set! value
              (if (> *closest-buzzer-dist* (meters 40)) 
                "-/8m" 
                (mod-tenths-str (/ *closest-buzzer-dist* (meters 1)))
                )
              )
            )
          (('rule-sniper) 
            (set! label (text-id mod-hud-last-kill))
            (set! value
              (if (< *last-kill-dist* (meters 0)) 
                "-" 
                (mod-tenths-str (/ *last-kill-dist* (meters 1)))
                )
              )
            )
          (('complication-bus-driver) 
            (set! label (text-id mod-hud-speed))
            (if *target* 
              (string-format "~D/20.0" (/ (-> *target* control ctrl-xz-vel) (meters 1)))
              "-/20.0"
              )
            )
          (('rule-speed) 
            (set! label (text-id mod-hud-speed))
            (if *target* 
              (mod-tenths-str (/ (-> *target* control ctrl-xz-vel) (meters 1))) 
              "-"
              )
            )
          (('complication-get-a-grip) 
            (set! label (text-id mod-hud-death))
            (let* ((elapsed (- (current-time) (-> *MOD-rule-context-bank* get-a-grip-last-grab)))
                   (grip-left (max 0 (- (mod-apply-time-limit-multiplier (seconds 12)) elapsed))))
              (set! value (string-format "~D/~D" progress goal))
              )
            )
          (else 
            (set! label (text-id mod-hud-progress))
            (set! value (string-format "~D/~D" progress goal))
            )
          )
        (mod-rule-draw-labeled-value!
          (text-id->string label)
          text-box-height
          (font-color progress)
          value
          row
          )
        )
      (+! row (mod-scale-px text-box-height))
      )
    )

;;     ;; Draw math quiz
;;     (when (eq? id 'rule-math-quiz)
;;       (let ((op-string (cond
;;                          ((= (-> *MOD-quiz-bank* math-op) 0) "+")
;;                          ((= (-> *MOD-quiz-bank* math-op) 1) "-")
;;                          (else "*"))))
;;         (format (clear *temp-string*)
;;                 "~D ~S ~D = ~1L~D"
;;                 (-> *MOD-quiz-bank* math-val1)
;;                 op-string
;;                 (-> *MOD-quiz-bank* math-val2)
;;                 (-> *MOD-quiz-bank* math-current-guess))
;;         (mod-draw-string-xy-scaled *temp-string* buf 10 row (font-color white) (mod-hud-flags) 0.6)
;;         (+! row (mod-scale-px 18))
;;         )
;;       )

;;     ;; Draw trivia
;;     (when (eq? id 'rule-trivia)
;;       (let* ((q-idx (-> *MOD-quiz-bank* trivia-current-question))
;;              (choice-str (if (= (-> *MOD-quiz-bank* trivia-current-guess) -1)
;;                            "USE D-PAD"
;;                            (mod-get-trivia-choice-str q-idx (-> *MOD-quiz-bank* trivia-current-guess)))))
;;         (format (clear *temp-string*) "~S" (-> *mod-trivia-questions* q-idx))
;;         (set! row (mod-rule-draw-wrapped! buf #f *temp-string* 27 10 row 0.35 8))
;;         (format (clear *temp-string*) " ~S" choice-str)
;;         (mod-draw-string-xy-scaled *temp-string* buf (mod-scale-px 20) row (font-color default) (mod-hud-flags) 0.47)
;;         (+! row (mod-scale-px 18))
;;         )
;;       )
      

      ;; Draw rule countdown
      (set! text-scale 0.4)
      (set! text-box-height (mod-text-box-relative-height text-scale 1))
      (mod-draw-text
        (mod-format-time-frame time-left 1 'auto)
        *mod-hud-x*
        row
        *mod-hud-slot-width*
        text-box-height
        (font-color white)
        (mod-hud-flags)
        text-scale
        )
      (+! row (mod-scale-px text-box-height))
      
      ;; Draw press to pass text
      (set! text-scale 0.3)
      (when (> (-> *MOD-pass-bank* passes) 0)
        (mod-draw-text 
          (text-id->string (text-id mod-hud-press-to-pass))
          80
          (- row (mod-scale-px text-box-height))
          *mod-hud-slot-width*
          text-box-height
          (font-color menu-parent)
          (mod-hud-flags)
          text-scale
          )
        )
      )
    (none)
    )

