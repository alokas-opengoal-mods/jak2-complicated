(define *mod-hud-dry-run* #f)
(define *mod-hud-top* 40) ;; y of the first block
(define *mod-hud-bottom* 185) ;; blocks should end here
(define *mod-hud-slot-gap* 12) ;; extra space between blocks
(define *mod-hud-reverted-y* 207) ;; REVERTED notice
(define *mod-hud-x* 10) ;; outcome / pending text
(define *mod-hud-text-box-default-height* 15)
(define *mod-hud-slot-width* 180)
(define *mod-hud-slot-height* 100)
(define *mod-hud-empty-height* 28)
(defconstant SCREEN_WIDTH_UNITS 512)
(defconstant SCREEN_HEIGHT_UNITS 412)

;; Height each slot reserved last frame.
(define *mod-hud-slot-heights* 
  (new 'static 'boxed-array :type int32 
    :length 5 
    :allocated-length 5
    )
  )

(define *mod-hud-full-heights* 
  (new 'static 'boxed-array :type int32 
    :length 5 
    :allocated-length 5
    )
  )

(defmacro mod-hud-flags ()
  `(font-flags shadow kerning large)
  )

(defmacro screen-right-x-offset (x)
  "X offset from the right side of the screen"
  `(- SCREEN_WIDTH_UNITS (adjust-game-x (the float (the int ,x))))
  )

(define *mod-hud-right-x* (screen-right-x-offset 120))

;; Format ticks as [H:]M:SS with 0-3 decimals.
(defun mod-format-time-frame ((tf time-frame) (decimal-digits int) (hours-mode symbol))
  (let* ((ticks (max 0 (the int tf)))
         (total-seconds (the int (/ ticks (seconds 1))))
         (hours (the int (/ total-seconds 3600)))
         (minutes-full (the int (/ total-seconds 60)))
         (minutes-part (the int (mod minutes-full 60)))
         (seconds-part (the int (mod total-seconds 60)))
         (show-hours? (or (eq? hours-mode 'always) 
                          (and (eq? hours-mode 'auto) 
                               (> hours 0))))
         (minutes-out (if show-hours? 
                          minutes-part 
                          minutes-full))
         (frac-tenths (the int (/ (* (mod ticks (seconds 1)) 10) (seconds 1))))
         (frac-hundredths (the int (/ (* (mod ticks (seconds 1)) 100) (seconds 1))))
         (frac-millis (the int (/ (* (mod ticks (seconds 1)) 1000) (seconds 1)))))
    (cond
      ((and show-hours? (= decimal-digits 3))
        (string-format "~D:~2,'0D:~2,'0D.~3,'0D" hours minutes-out seconds-part frac-millis)
        )
      ((and show-hours? (= decimal-digits 2))
        (string-format "~D:~2,'0D:~2,'0D.~2,'0D" hours minutes-out seconds-part frac-hundredths)
        )
      ((and show-hours? (= decimal-digits 1))
        (string-format "~D:~2,'0D:~2,'0D.~1,'0D" hours minutes-out seconds-part frac-tenths)
        )
      (show-hours? 
        (string-format "~D:~2,'0D:~2,'0D" hours minutes-out seconds-part)
        )
      ((= decimal-digits 3) 
        (string-format "~D:~2,'0D.~3,'0D" minutes-out seconds-part frac-millis)
        )
      ((= decimal-digits 2) 
        (string-format "~D:~2,'0D.~2,'0D" minutes-out seconds-part frac-hundredths)
        )
      ((= decimal-digits 1) 
        (string-format "~D:~2,'0D.~1,'0D" 
          minutes-out 
          seconds-part 
          frac-tenths
          )
        )
      (else 
        (string-format "~D:~2,'0D" minutes-out seconds-part)
        )
      )
    )
  )

;; scales a row-spacing/indent pixel offset by the same multiplier as the HUD text
(defun mod-scale-px ((n int))
  (the int (* (the float n) (text-scale-multiplier)))
  )

(defun mod-draw-text ((text string) (x int) (y int) (width int) (height int) (color font-color) (flags font-flags) (scale float))
  (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags))))
    (set-origin! font-ctx x y)
    (set-width! font-ctx (mod-scale-px width))
    (set-height! font-ctx (mod-scale-px height))
    (set-color! font-ctx color)
    (set-flags! font-ctx flags)
    (set-scale! font-ctx (* scale (text-scale-multiplier)))
    (print-game-text text font-ctx #f 44 (bucket-id debug-no-zbuf2))
    )
  (none)
  )

(defun mod-text-box-relative-height ((text-scale float) (rows int))
  "Default ratio is 0.5 scale to 20 height.
   Text box will basically be character height + 5 units"
  (the int (+ (* (/ text-scale 0.5) *mod-hud-text-box-default-height* rows) (* 5.0 rows)))
  )

