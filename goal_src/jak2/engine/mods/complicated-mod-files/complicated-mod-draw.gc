(defun mod-rule-draw-separator ((y int))
  (mod-draw-text
    "--------------------"
    *mod-hud-x*
    y
    *mod-hud-slot-width*
    *mod-hud-text-box-default-height*
    (font-color menu-parent)
    (mod-hud-flags)
    0.3
    )
  (none)
  )

(defun mod-draw-timed-punishments ()
  (let ((row-count 0))
    (dotimes (slot *mod-timed-punishment-slot-count*)
      (let ((id (-> (-> *MOD-punishment-bank* timed-punishments) slot)))
        (when id
          (let* ((time-left (max 0 (- (-> (-> *MOD-punishment-bank* timed-end-times) slot) (current-time))))
                (text-scale 0.3)
                (x (- SCREEN_WIDTH_UNITS (mod-scale-px 55)))
                (row (+ 80 (* row-count (mod-text-box-relative-height text-scale 1))))
                )
            ;; Draw countdown
            (mod-draw-text
              (mod-format-time-frame time-left 1 'auto)
              x
              (- row 2)
              100
              *mod-hud-text-box-default-height*
              (font-color white)
              (mod-hud-flags)
              0.4
              )
            ;; Draw label
            (mod-draw-text
              ;; (mod-timed-punishment-name punishment)
              (text-id->string (-> (mod-punishment-info-get id) name-text))
              (- x (mod-scale-px 10))
              row
              100
              *mod-hud-text-box-default-height*
              (font-color white)
              (font-flags large kerning shadow right)
              0.3
              )
            (+! row-count 1)
            )
          )
        )
      )
    )
  (none))

;; Last outcome, then the countdown to its next roll.
(defun mod-rule-draw-empty-slot ((slot int) (y int))
  (let* ((outcome (-> (-> *MOD-rule-slot-bank* slot-outcomes) slot))
        (msg 
          (case outcome
            (('success) (text-id mod-hud-good-job))
            (('failed) (text-id mod-hud-rule-broken))
            (('twisted-success 'twisted-failed) (text-id mod-hud-twisted-rule))
            (('skipped) (text-id mod-hud-pass))
            (else #f)
            )
          )
        (color 
          (case outcome
            (('success 'twisted-success) (font-color green))
            (('skipped) (font-color pink))
            (else (font-color red))
            )
          )
        (text-scale 0.4)
        (text-box-height (mod-text-box-relative-height text-scale 1))
        )
    (when msg
      ;; (mod-draw-string-xy-scaled (the-as string msg) buf *mod-hud-x* y color (mod-hud-flags) 0.4)
      (set! text-scale 0.4)
      (set! text-box-height (mod-text-box-relative-height text-scale 1))
      (mod-draw-text
        (text-id->string (the text-id msg))
        *mod-hud-x*
        y
        *mod-hud-slot-width*
        *mod-hud-text-box-default-height*
        color
        (mod-hud-flags)
        text-scale
        )
      (+! y text-box-height)
      )
    (when (and (eq? (-> (-> *MOD-rule-slot-bank* pending-slots) slot) 'mod-rule-pending-roll)
               (> (mod-rule-target-slot-count) 0)
               (mod-rule-roll-possible?))
      (let* ((left (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time))))
             (timer (mod-format-time-frame left 1 'auto))
             )
        (set! text-scale 0.4)
        (set! text-box-height (mod-text-box-relative-height text-scale 1))
        (mod-draw-text
          (string-format (text-id->string (text-id mod-hud-next-condition)) timer)
          *mod-hud-x*
          y
          300
          text-box-height
          (font-color white)
          (mod-hud-flags)
          text-scale
          )
        )
      )
    )
  (none)
  )



;; Draw the whole HUD.
(defun mod-run-hud-draw ()
  (cond
    ((-> *MOD-countdown-bank* active?)
      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id debug-no-zbuf2))
        (draw-sprite2d-xy 
          buf
          *mod-hud-x*
          *mod-hud-top*
          *mod-hud-slot-width*
          *mod-hud-slot-height*
          (static-rgba 0 0 0 48)
          )
        )
      ;; Draw seed
      (mod-draw-text
        (string-format (text-id->string (text-id mod-hud-seed)) (-> *MOD-rng-bank* seed-display))
        4
        398
        200
        20
        (font-color flat-yellow)
        (mod-hud-flags)
        0.4
        )

      ;; Draw main countdown timer
      (mod-draw-text
        (mod-format-time-frame (-> *MOD-countdown-bank* remaining-time) 2 'auto)
        (screen-right-x-offset (mod-scale-px 100))
        *mod-hud-top*
        100
        20
        (font-color red)
        (mod-hud-flags)
        0.6
        )

      ;; Draw countup timer
      (when (show-countup-timer-enabled?)
        (let ((show-hours? (> (the int (/ (-> *MOD-countdown-bank* countup-timer) (seconds 3600))) 0)))
          (mod-draw-text 
            (mod-format-time-frame (-> *MOD-countdown-bank* countup-timer) 2 'auto)
            (screen-right-x-offset (mod-scale-px 100))
            (+ *mod-hud-top* -20)
            100
            20
            (font-color white)
            (mod-hud-flags)
            0.4
            )
          )
        )
      (mod-draw-timed-punishments)
      ;; Blocks stack in slot order
      (let* ((band-count (mod-rule-hud-band-count))
              (compact? (> band-count 2))
              ;; (compact? #f)
              (y *mod-hud-top*))
        ;; Draw reverted cell text
        ;; (when (> (-> *MOD-rule-context-bank* last-reverted-cell-until) (current-time))
        ;;   (mod-draw-string-xy-scaled 
        ;;     (string-format "REVERTED: ~A" (mod-revert-cell-name (the game-task (-> *MOD-rule-context-bank* last-reverted-cell-task))))
        ;;     buf
        ;;     10
        ;;     *mod-hud-reverted-y*
        ;;     (font-color red)
        ;;     (mod-hud-flags)
        ;;     0.35
        ;;     )
        ;;   )

        ;; Draw condition slots
        (dotimes (slot band-count)
          (let ((height 0))
            (if (-> (-> *MOD-rule-slot-bank* active-slots) slot)
              (begin
                (mod-rule-draw-slot slot y compact?)
                (set! height *mod-hud-slot-height*)
                (set! (-> *mod-hud-slot-heights* slot) height)
                )
              (begin
                (set! height (max *mod-hud-empty-height* (-> *mod-hud-slot-heights* slot)))
                (mod-rule-draw-empty-slot slot y)
                )
              )
            (+! y (mod-scale-px height))
            (when (and (< (+ slot 1) band-count)
                        (or (-> (-> *MOD-rule-slot-bank* active-slots) (+ slot 1))
                            (-> (-> *MOD-rule-slot-bank* pending-slots) (+ slot 1))
                            ))
              (mod-rule-draw-separator y)
              )
            (when (< (+ slot 1) band-count)
              (+! y (mod-scale-px *mod-hud-slot-gap*))
              )
            )
          )
        )
      )
    (else (none))
    )
  (none)
  )


(defun draw-complicated-mod-title ()
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id debug-no-zbuf2))
    (let ((title-row 30)
          (title-x 10))
      (draw-string-xy-scaled "A COMPLICATED MOD" buf title-x title-row (font-color green) (mod-hud-flags) 0.8)
      (+! title-row (mod-scale-px 15))
      (draw-string-xy-scaled "A COMPLICATED MOD WITH RULES."
                             buf
                             title-x
                             title-row
                             (font-color white)
                             (mod-hud-flags)
                             0.4)
      (+! title-row (mod-scale-px 10))
      (draw-string-xy-scaled "" buf title-x title-row (font-color yellow) (mod-hud-flags) 1.0)))
  (none))