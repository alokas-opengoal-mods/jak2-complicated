(define *mod-difficulty*
  (new 'static 'boxed-array :type symbol
    'easy
    'medium
    'hard
    'unfathomable
    )
  )

(define *mod-game-mode*
  (new 'static 'boxed-array :type symbol
    'casual
    'timed
    )
  )


(deftype complicated-settings (basic)
  (;; Rules
    (rule-grounded?                 symbol)
    (rule-die?                      symbol)
    (rule-kill-pressure?          symbol)
    (rule-hitlist?                  symbol)
    (rule-crate-break?              symbol)
