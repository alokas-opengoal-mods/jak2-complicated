(defun mod-condition-enabled? ((id symbol))
  (the symbol
    (case id
      (('rule-grounded) (-> *complicated-settings* rule-grounded?))
      (('rule-die) (-> *complicated-settings* rule-die?))
      (('rule-kill-pressure) (-> *complicated-settings* rule-kill-pressure?))
      (('rule-hitlist) (-> *complicated-settings* rule-hitlist?))
      (('rule-crate-break) (-> *complicated-settings* rule-crate-break?))
      (('complication-brittle-bones) (-> *complicated-settings* complication-brittle-bones?))
      (('complication-rotten-eggs) (-> *complicated-settings* complication-rotten-eggs?))
      (('rule-keep-it-low) (-> *complicated-settings* rule-keep-it-low?))
      (('rule-money-pressure) (-> *complicated-settings* rule-money-pressure?))
      (('rule-fuel-pressure) (-> *complicated-settings* rule-fuel-pressure?))
      (('complication-eco-allergy) (-> *complicated-settings* complication-eco-allergy?))
      (('complication-sizeable) (-> *complicated-settings* complication-sizeable?))
      (('complication-ohko) (-> *complicated-settings* complication-ohko?))
      (('complication-glare) (-> *complicated-settings* complication-glare?))
