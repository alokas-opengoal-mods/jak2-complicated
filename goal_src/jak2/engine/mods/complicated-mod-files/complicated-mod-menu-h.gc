(define *mod-difficulty*
  (new 'static 'boxed-array :type symbol
    'easy
    'medium
    'hard
    'unfathomable
    )
  )

(define *mod-game-mode*
  (new 'static 'boxed-array :type symbol
    'casual
    'timed
    )
  )


(deftype complicated-settings (basic)
  (;; Rules
    (rule-grounded?                 symbol)
    (rule-die?                      symbol)
    (rule-kill-pressure?            symbol)
    (rule-hitlist?                  symbol)
    (rule-crate-break?              symbol)
    (rule-keep-it-low?              symbol)
    (rule-money-pressure?           symbol)
    (rule-fuel-pressure?            symbol)
    (rule-flop-this?                symbol)
    (rule-buzzer-pressure?          symbol)
    (rule-one-frame?                symbol)
    (rule-distancing?               symbol)
    (rule-red-light?                symbol)
    (rule-for-billy?                symbol)
    (rule-sniper?                   symbol)
    (rule-cold-feet?                symbol)
    (rule-speed?                    symbol)
    (rule-math-quiz?                symbol)
    (rule-trivia?                   symbol)
    (rule-green-pilled?             symbol)
    (rule-button-pusher?            symbol)
    (rule-cooked?                   symbol)
    (rule-sagging-sails?            symbol)
    (rule-side-to-side?             symbol)
    (rule-landlubber?               symbol)
    (rule-loyal-customer?           symbol)
    (rule-double-kill?              symbol)
    (rule-express-delivery?         symbol)
    (rule-qte?                      symbol)
    (rule-touch-grass?              symbol)
    (rule-hang-time?                symbol)
    (rule-no-harm?                  symbol)
    (rule-supercharged?             symbol)
    (rule-keep-rolling?             symbol)
    (rule-uncharted?                symbol)
    (rule-orb-hunt?                 symbol)
    (rule-no-ledge?                 symbol)
    (rule-management?               symbol)
    (rule-survivor?                 symbol)
    (rule-vendetta?                 symbol)
    (rule-hands-on?                 symbol)
    (rule-shocked?                  symbol)
    (rule-green-light?              symbol)
    (rule-propaganda?               symbol)
    (rule-trigger-discipline?       symbol)
    (rule-trickster?                symbol)
    (rule-stay-on-board?            symbol)
    (rule-gem-pressure?             symbol)

    ;; Complications
    (complication-brittle-bones?    symbol)
    (complication-rotten-eggs?      symbol)
    (complication-eco-allergy?      symbol)
    (complication-sizeable?         symbol)
    (complication-ohko?             symbol)
    (complication-glare?            symbol)
    (complication-heating-balloons? symbol)
    (complication-disassociate?     symbol)
