;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MENU OPTIONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro mod-progress-new-generic-link-to-scrolling-page (title &key (should-disable? #f) &rest options)
  `(new 'static 'mod-menu-generic-link-option
    :name ,title
    :should-disable? ,should-disable?
    :target (new 'static 'menu-option-list
      :options (new 'static 'boxed-array :type menu-option
      (new 'static 'mod-menu-generic-scrolling-page
       :name ,title
       :menu-options (new 'static 'boxed-array :type menu-option
       ,@options))))))



(defmacro mod-page-rules ()
  `(mod-progress-new-generic-link-to-scrolling-page (text-id mod-progress-rule-options)
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-grounded-name)
      :description (text-id rule-grounded-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-grounded?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* rule-grounded?) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-die-name)
      :description (text-id rule-die-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-die?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* rule-die?) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-survivor-name)
      :description (text-id rule-survivor-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-survivor?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* rule-survivor?) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-kill-pressure-name)
      :description (text-id rule-kill-pressure-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-kill-pressure?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *complicated-settings* rule-kill-pressure?) val)
        ;; (complicated-settings-save)
        )
      )
    (new 'static 'mod-menu-generic-boolean-option
      :name (text-id rule-hitlist-name)
      :description (text-id rule-hitlist-desc)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *complicated-settings* rule-hitlist?))
