  ;; (set! (-> obj rule-trivia?)                   #t)
  (set! (-> obj rule-green-pilled?)             #t)
  (set! (-> obj rule-button-pusher?)            #t)
  (set! (-> obj rule-cooked?)                   #t)
  ;; (set! (-> obj rule-sagging-sails?)            #t)
  ;; (set! (-> obj rule-side-to-side?)             #t)
  ;; (set! (-> obj rule-landlubber?)               #t)
