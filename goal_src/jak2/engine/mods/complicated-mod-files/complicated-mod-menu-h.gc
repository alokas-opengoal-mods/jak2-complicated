(defun mod-condition-enabled? ((id symbol))
  (the symbol
    (case id
      (('rule-grounded) (-> *complicated-settings* rule-grounded?))
      (('rule-die) (-> *complicated-settings* rule-die?))
      (('rule-kill-pressure) (-> *complicated-settings* rule-kill-pressure?))
      (('rule-hitlist) (-> *complicated-settings* rule-hitlist?))
      (('rule-crate-break) (-> *complicated-settings* rule-crate-break?))
      (('complication-brittle-bones) (-> *complicated-settings* complication-brittle-bones?))
      (('complication-rotten-eggs) (-> *complicated-settings* complication-rotten-eggs?))
      (('rule-keep-it-low) (-> *complicated-settings* rule-keep-it-low?))
      (('rule-money-pressure) (-> *complicated-settings* rule-money-pressure?))
      (('rule-fuel-pressure) (-> *complicated-settings* rule-fuel-pressure?))
      (('complication-eco-allergy) (-> *complicated-settings* complication-eco-allergy?))
      (('complication-sizeable) (-> *complicated-settings* complication-sizeable?))
      (('complication-ohko) (-> *complicated-settings* complication-ohko?))
      (('complication-glare) (-> *complicated-settings* complication-glare?))
      (('complication-heating-balloons) (-> *complicated-settings* complication-heating-balloons?))
      (('rule-flop-this) (-> *complicated-settings* rule-flop-this?))
      (('complication-disassociate) (-> *complicated-settings* complication-disassociate?))
      (('complication-bus-driver) (-> *complicated-settings* complication-bus-driver?))
      (('rule-buzzer-pressure) (-> *complicated-settings* rule-buzzer-pressure?))
      (('complication-wings-tied) (-> *complicated-settings* complication-wings-tied?))
      (('rule-survivor) (-> *complicated-settings* rule-survivor?))
      (('complication-fuel-shortage) (-> *complicated-settings* complication-fuel-shortage?))
      (('complication-drought) (-> *complicated-settings* complication-drought?))
      (('rule-management) (-> *complicated-settings* rule-management?))
      (('complication-jak-rabbit) (-> *complicated-settings* complication-jak-rabbit?))
      (('complication-hidden-treasure) (-> *complicated-settings* complication-hidden-treasure?))
      (('rule-vendetta) (-> *complicated-settings* rule-vendetta?))
      (('rule-hands-on) (-> *complicated-settings* rule-hands-on?))
