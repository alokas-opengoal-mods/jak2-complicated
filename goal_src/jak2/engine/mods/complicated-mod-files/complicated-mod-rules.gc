    'rule-hang-time                 'rule-keep-it-low
    'complication-sidekicked        'rule-flop-this
    'complication-sidekicked        'complication-bus-driver
    'complication-sidekicked        'complication-butter-fingers
    'complication-sidekicked        'rule-sniper
    'complication-sidekicked        'rule-button-pusher
    'complication-sidekicked        'rule-hang-time
    'complication-sidekicked        'complication-get-a-grip
    'complication-sidekicked        'rule-keep-rolling
    'rule-green-light               'rule-red-light
    )
  )

(defun mod-rule-pending? ((id symbol))
  (>= (mod-symbol-index (-> *MOD-rule-slot-bank* pending-slots) id) 0)
  )

(defun mod-rule-active-slot-count ()
  (let ((slot 0)
        (count 0))
    (while (< slot *mod-rule-slot-count*)
      (when (or (-> (-> *MOD-rule-slot-bank* active-slots) slot) 
                (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
                )
        (+! count 1)
        )
      (+! slot 1)
      )
    count
    )
  )

(defun mod-rule-any-rule-active? ()
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when (and id (eq? (mod-rule-type id) 'rule))
          (set! found #t)
          )
        )
      (+! slot 1)
      )
    found
    )
  )

(defun mod-rule-first-free-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (and (not (-> (-> *MOD-rule-slot-bank* active-slots) slot)) 
                 (not (-> (-> *MOD-rule-slot-bank* pending-slots) slot))
                 )
        (set! result slot)
        )
      (+! slot 1)
      )
    result
    )
  )

(defun mod-rule-first-occupied-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (or (-> (-> *MOD-rule-slot-bank* active-slots) slot) 
                (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
                )
        (set! result slot)
        )
      (+! slot 1)
      )
    result
    )
  )

(defun mod-rule-clear-slot ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (set! (-> (-> *MOD-rule-slot-bank* active-slots) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-grace-periods) slot) 0)
    )
  (none)
  )

;; Remember the last outcome shown in a slot's band.
(defun mod-rule-set-slot-outcome! ((slot int) (outcome symbol))
  (when (and (>= slot 0) 
             (< slot *mod-rule-slot-count*))
    (set! (-> (-> *MOD-rule-slot-bank* slot-outcomes) slot) outcome)
    )
  (none)
  )

(defun mod-rule-clear-slot-outcomes! ()
  (dotimes (slot *mod-rule-slot-count*)
    (set! (-> (-> *MOD-rule-slot-bank* slot-outcomes) slot) 'none)
    )
  (none)
  )

(defun city-level? ((level symbol))
  (case level
    (('ctygena
      'ctygenb
      'ctygenc
      'ctysluma
      'ctyslumb
      'ctyslumc
      'ctyport
      'ctyfarma
      'ctyfarmb
      'ctyinda
      'ctyindb
      'ctymarka
      'ctymarkb
      'ctypal
      'hideout)
      #t
      )
    )
  )

(defun sparse-enemy-level? ((level symbol))
  (case level
    (('ruins)
      (or (task-node-open? (game-task-node ruins-mech-resolution)))
      )
    (('sewer)
      (or (task-node-open? (game-task-node sewer-board-resolution))
          (task-node-open? (game-task-node sewer-board-drain))
          )
      )
    (('fortress
      'forexita
      'forexitb
      'fordumpa
      'fordumpc
      )
      (or 
        (task-node-open? (game-task-node fortress-escape-introduction))
        (task-node-open? (game-task-node fortress-escape-resolution))
        (= (current-checkpoint-name) "fordumpa-start")
        (= (current-checkpoint-name) "fordumpc-start")
        (= (current-checkpoint-name) "fordumpc-movie")
        (= (current-checkpoint-name) "fordumpc-explode")
        )
      )
      (('gungame
        'mincan
        'prison
        'tomba
        'tombb
        'tombc
        'tombboss
        'palcab
        'palroof
        )
        #t
        )
    )
  )

(defun sparse-hitlist-level? ((level symbol))
  (or (sparse-enemy-level? level)
    (case level
      (('ruins)
        (or (task-node-open? (game-task-node ruins-mech-resolution))
            (task-node-open? (game-task-node ruins-tower-resolution))
            )
        )
      (('sewer)
        (or (task-node-open? (game-task-node sewer-escort-resolution))
            )
        )
      (('forexita
        'forexitb
        'fordumpa
        'fordumpb
        'fordumpc
        'forresca
        'forrescb
        'prison
        'tomba
        'tombb
        'tombc
        'tombboss
        'castle
        'casboss
        )
        #t
        )
      )
    )
  )

(defun level-has-entity? ((e symbol))
  (dotimes (i (-> *level* length))
    (let ((level (-> *level* level i)))
      (when (= (-> level status) 'active)
        ;; actor entities
        (let ((actors (-> level bsp actors)))
          (when (nonzero? actors)
            (dotimes (ii (-> actors length))
              (let ((entity (-> actors data ii actor)))
                ;; (format #t "Level entity ~D: ~S~%" 
                ;;   ii 
                ;;   (the string (-> entity etype symbol))
                ;;   )
                (when (and (= (-> entity etype symbol) e)
                            (or (not (-> entity extra)) 
                                (zero? (-> entity extra)) 
                                (not (logtest? (-> entity extra perm status) (entity-perm-status dead)))
                                ))
                    ;; (format #t "  Status: ~S" (the string (-> entity extra perm status)))
                    (return #t)
                  )
                )
              )
            )
          )
        )
      )
    )
  )




(defun active-level-enemy-count ()
  (let ((enemy-count 0))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (= (-> lev status) 'active)
          ;; actor entities
          (let ((actors (-> lev bsp actors)))
            (when (nonzero? actors)
              (dotimes (ii (-> actors length))
                (let ((entity (-> actors data ii actor)))
                  (when (and (case (-> entity etype symbol) 
                                (('amphibian
                                  'fodder
                                  'guard
                                  'crimson-guard-level
                                  'crimson-guard-hover
                                  'metalmonk
                                  'hopper
                                  'centurion
                                  'grunt
                                  'flitter
                                  'flamer
                                  'wasp
                                  'rapid-gunner
                                  'shield-gunner
                                  'grenadier
                                  'flying-spider
                                  'mantis
                                  'ginsu
                                  'jellyfish
                                  'monster-frog
                                  'tomb-baby-spider
                                  'spyder
                                  'juicer
                                  'spydroid
                                  ) #t)
                                  )
                              (or (not (-> entity extra))
                                  (zero? (-> entity extra))
                                  (not (logtest? (-> entity extra perm status) (entity-perm-status dead bit-0)))
                                  )
                              )
                      (+! enemy-count 1)
                      ;; (format #t "Level enemy ~D: ~S~%"
                      ;;   enemy-count 
                      ;;   (the string (-> entity etype symbol))
                      ;;   )
                    )
                  )
                )
              )
            )
          )
        )
      )
    ;; (format #t "Level enemy count: ~D~%" enemy-count)
    enemy-count
    )
  )

(defun level-has-enough-enemies? ((count int))
  (>= (active-level-enemy-count) count)
  )

