(defun mod-rule-type ((id symbol))
  (-> *mod-rules* (mod-rule-index-from-id id) rule-type)
  )

;; Grace period after activation during which a failure is ignored.
(defun mod-rule-grace-period ((id symbol))
  (let ((grace (-> (mod-rule-info-get id) grace-period)))
    (if (> grace 0)
      grace
      (seconds 1.25) ;; default grace-period
      )
    )
  )


;; Pairs of conditions that must never be active together.
(define *mod-rule-conflict-pairs*
  (new 'static 'boxed-array :type symbol
    'rule-sniper 'rule-flop-this
    'rule-kill-pressure 'rule-no-harm
    'rule-kill-pressure 'complication-soul-bond
    'rule-no-harm 'rule-sniper
    'complication-soul-bond 'rule-sniper
    'rule-hitlist 'rule-no-harm
    'rule-double-kill 'rule-no-harm
    'complication-soul-bond 'complication-disassociate
    'rule-hitlist 'complication-soul-bond
    'rule-double-kill 'complication-soul-bond
    'rule-buzzer-pressure 'rule-distancing
    'complication-fuel-shortage 'rule-loyal-customer
    'rule-grounded 'rule-hang-time
    'rule-grounded 'rule-qte
    'rule-die 'rule-survivor
    'rule-red-light 'rule-qte
    'rule-management 'rule-qte
    'rule-management 'complication-joyride
    'rule-keep-it-low 'complication-joyride
    'complication-sizeable 'complication-joyride
    'complication-butter-fingers 'complication-joyride
    'rule-keep-rolling 'complication-joyride
    'complication-get-a-grip 'complication-joyride
    'rule-math-quiz 'rule-trivia
    'rule-landlubber 'complication-drought
    'rule-buzzer-pressure 'complication-unbreakable
    'rule-fuel-pressure 'complication-fuel-shortage
    'complication-rotten-eggs 'rule-money-pressure
    'rule-green-pilled 'complication-eco-allergy
    'complication-get-a-grip 'complication-butter-fingers
    'rule-red-light 'complication-bus-driver
    'complication-fuel-shortage 'complication-wings-tied
    'rule-for-billy 'rule-express-delivery
    'rule-survivor 'complication-ohko
    'rule-survivor 'complication-vibe-check
    'complication-rotten-eggs 'rule-loyal-customer
    'rule-orb-hunt 'complication-hidden-treasure
    'complication-glare 'rule-kill-pressure
    'rule-die 'rule-touch-grass
