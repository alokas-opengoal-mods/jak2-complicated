(defun gun-owned? ((gun symbol))
  (logtest? (-> *game-info* features)
    (case gun
      (('gun-yellow) (game-feature gun-yellow))
      (('gun-red) (game-feature gun-red))
      (('gun-blue) (game-feature gun-blue))
      (('gun-dark) (game-feature gun-dark))
      (('any) (game-feature gun))
      )
    )
  )

;; True if the twist state forbids rolling this id (rules while a twist is pending/marked, twist while one is already in progress).
(defun mod-rule-twist-blocks? ((id symbol))
  (cond
    ((eq? (mod-rule-type id) 'rule)
      (or (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) 
          (mod-rule-active? 'complication-twisted)
          )
      )
    ((eq? id 'complication-twisted)
      (or (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
          (mod-rule-any-rule-active?)
          (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0)
          )
      )
    (else #f)
    )
  )

(defun mod-rule-conflicts-with-active? ((id symbol))
  (let ((i 0)
        (hit #f))
    (while (and (< i (-> *mod-rule-conflict-pairs* length)) 
                (not hit))
      (let ((a (-> *mod-rule-conflict-pairs* i))
            (b (-> *mod-rule-conflict-pairs* (+ i 1))))
        (when (or (and (= id a) (mod-rule-active? b)) 
                  (and (= id b) (mod-rule-active? a)))
          (set! hit #t)
          )
        )
      (+! i 2)
      )
    hit
    )
  )


;; Roll conditions for each rule
(defun mod-rule-can-roll? ((id symbol))
  (let ((is-pilot? (or (mod-target-on-mode? 'pilot)
                       (mod-target-on-mode? 'racer)))
        (is-mech? (mod-target-on-mode? 'mech))
        (is-turret? (= (-> *target* state name) 'target-turret-stance))
        (is-indax? (mod-target-on-mode? 'indax))
        (is-minigame? (or (task-node-open? (game-task-node city-play-onin-game-resolution))
                          (task-node-open? (game-task-node city-whack-resolution))
                          ))
        (checkpoint-name (current-checkpoint-name))
        (level-name (current-level-name))
        )
    (case id
      (('rule-grounded)
        (and
          (not is-pilot?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('rule-die)
        (not is-minigame?)
        )
      (('rule-survivor)
        (not is-minigame?)
        )
      (('rule-kill-pressure)
        (and
          (not (sparse-enemy-level? level-name))
          (not (in-race?))
          (not is-minigame?)
          )
        )
      (('rule-hitlist)
        (and
          (not (sparse-hitlist-level? level-name))
          (not is-pilot?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('rule-crate-break)
        (and 
          ;; (level-has-entity? 'crate)
          (level-has-crate? level-name)
          )
        )
      (('complication-brittle-bones)
        (and
          (not is-mech?)
          (not is-turret?)
          (not is-minigame?)
          (not (in-race?))
          )
        )
      (('rule-keep-it-low)
        (and
          (not is-pilot?)
          (not is-mech?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('rule-money-pressure)
        (and 
          (level-has-entity? 'skill)
          (not is-minigame?)
          )
        )
      (('complication-ohko)
        (not is-minigame?)
        )
      (('complication-glare)
        (and
          (not (sparse-enemy-level? level-name))
          (not (in-race?))
          (not is-minigame?)
          )
        )
      (('rule-flop-this)
        (and
          (not (sparse-enemy-level? level-name))
          (not (in-race?))
          (not (in-bossfight?))
          (not is-minigame?)
          (not is-indax?)
          (not is-mech?)
          )
        )
      (('complication-bus-driver)
        (and
          is-pilot?
          )
        )
      (('rule-management)
        (and
          (not is-pilot?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('complication-jak-rabbit)
        (and
          (not is-pilot?)
          (not is-minigame?)
          )
        )
      (('rule-distancing)
        (and
          (task-node-open? (game-task-node stadium-board1-board))
          (task-node-open? (game-task-node stadium-board1-training))
          (task-node-open? (game-task-node stadium-board1-training-judge))
          (task-node-open? (game-task-node stadium-board1-done))
          (task-node-open? (game-task-node stadium-board1-resolution))
          (task-node-open? (game-task-node city-meet-brutter-resolution))
          (task-node-open? (game-task-node city-shuttle-shuttle))
          (task-node-open? (game-task-node city-shuttle-resolution))
          (task-node-open? (game-task-node city-save-lurkers-save-lurkers))
          (task-node-open? (game-task-node city-save-lurkers-resolution))
          (task-node-open? (game-task-node forest-scouts-pegasus))
          (task-node-open? (game-task-node forest-scouts-resolution))
          (task-node-open? (game-task-node city-errol-challenge-race))
          (task-node-open? (game-task-node city-errol-challenge-resolution))
          )
        )
      (('rule-red-light)
        (and
          (not is-minigame?)
          )
        )
      (('complication-butter-fingers)
        (and
          (not is-pilot?)
          (not is-minigame?)
          (not (in-bossfight?))
          )
        )
      (('rule-sniper)
        (and
          (not (sparse-enemy-level? level-name))
          (not is-minigame?)
          (not (in-bossfight?))
          (not (in-race?))
          (gun-owned? 'gun-yellow)
          )
        )
      (('rule-green-pilled)
        (and
          (level-has-health-pack? level-name)
          )
        )
      (('rule-button-pusher)
        (and
          (level-has-button? level-name)
          (not is-indax?)
          )
        )
      ;; (('complication-invisible-man)
      ;;   )
      (('rule-cooked)
        (and
          (level-can-burn? level-name)
          )
        )
      ;; (('complication-twisted)
      ;;   )
      (('complication-vibe-check)
        (and
          (> (-> *target* fact health) 2.0)
          (not is-mech?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('complication-income-tax)
        (not (in-bossfight?))
        )
      (('rule-double-kill)
        (and
          (not (sparse-enemy-level? level-name))
          (not (in-race?))
          (not (in-bossfight?))
          (not is-minigame?)
          )
        )
      ;; (('complication-mirror)
      ;;   )
      (('rule-hang-time)
        (and
          (not (in-race?))
          (not (in-bossfight?))
          (not is-turret?)
          (not is-mech?)
          (not is-indax?)
          (not is-minigame?)
          )
        )
      (('complication-get-a-grip)
        (and
          (not (in-race?))
          (not (in-bossfight?))
          (not is-turret?)
          (not is-mech?)
          (not is-indax?)
          (not is-minigame?)
          )
        )
      (('complication-jak-be-nimble)
        (and
          (not (in-race?))
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('rule-no-harm)
        (and
          (not (in-race?))
          (not (in-bossfight?))
          (not is-minigame?)
          )
        )
      (('complication-soul-bond)
        (and
          (not (in-race?))
          (not (in-bossfight?))
          (not is-minigame?)
          )
        )
      (('complication-shifty)
        (and
          (not is-turret?)
          (not is-minigame?)
          )
        )
      ;; (('complication-lights-out)
      ;;   )
      (('rule-keep-rolling)
        (and
          (not (in-race?))
          (not (in-bossfight?))
          (not is-turret?)
          (not is-pilot?)
          (not is-mech?)
          (not is-indax?)
          (not is-minigame?)
          )
        )
      (('complication-sidekicked)
        (and 
          (not is-pilot?)
          (not is-indax?)
          )
        )
      ;; (('complication-fast-target)
      ;;   )
      ;; (('complication-fast-entities)
      ;;   )
      ;; (('complication-slow-target)
      ;;   )
      ;; (('complication-slow-entities)
      ;;   )
      (('rule-shocked)
        (and
          (level-can-shock? level-name)
          (not (in-race?))
          )
        )
      (('complication-iron-man)
        (and
          (not is-pilot?)
          (not is-mech?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (('complication-pov)
        (and
          (not is-indax?)
          (not is-pilot?)
          (not is-turret?)
          (not is-mech?)
          (not is-minigame?)
          )
        )
      (('rule-propaganda)
        (and
          (case level-name
            (('ctysluma
              'ctyslumb
              'ctyport
              'ctyinda
              'ctyindb
              'hideout)
              #t
              )
            )
          (not is-minigame?)
          )
        )
      (('complication-car-trouble)
        (and
          (city-level? level-name)
          )
        )
      (('rule-green-light)
        (and
          (not is-pilot?)
          (not is-turret?)
          (not is-minigame?)
          )
        )
      (else #t)
      )
    )
  )


;; Roll weight for a condition.
(defun mod-rule-roll-priority ((id symbol))
  (cond
    ;; if these, don't roll
    ((or (not (mod-condition-enabled? id))
        (mod-rule-twist-blocks? id)
        (mod-rule-conflicts-with-active? id)
        )
      0
      )
    ;; else check rule specific conditions
    ((mod-rule-can-roll? id)
      (-> (mod-rule-info-get id) roll-weight)
      )
    (else 0)
    )
  )

