(defmethod draw-option ((obj mod-menu-generic-boolean-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
        )
    (set! (-> font-ctx alpha) alpha)
    (set-scale! font-ctx MOD_FONT_SIZE_OPTION)
    (+! (-> font-ctx origin y) 14.0)
    (cond
      (selected?
        (+! (-> font-ctx origin y) -8.0)
        (set-color! font-ctx (font-color progress-force-selected))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE_LARGE alpha)
        
        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))
        
        ;; Draw option description
        (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
          (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
          (set-flags! desc-font-ctx (font-flags kerning large))
          (set-scale! desc-font-ctx 0.3)
          (set-color! desc-font-ctx (font-color progress))
          (set-alpha! desc-font-ctx alpha)
          (+! (-> desc-font-ctx origin y) 20)

          ;; (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
          (print-game-text (text-id->string (-> obj description)) desc-font-ctx #f 44 (bucket-id progress))
          )

        ;; Draw option value
        (set-flags! font-ctx (font-flags right kerning large))
        (+! (-> font-ctx origin x) (-> font-ctx width))
        (set-color! font-ctx (progress-selected 0))

        (set! *progress-generic-temp-string* (clear *progress-generic-temp-string*))
        (if (-> obj value)
            (format *progress-generic-temp-string* "~33L~S~35L ~S" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
            (format *progress-generic-temp-string* "~35L~S ~33L~S~1L" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
            )
        )
      (else
        (cond
          ((and (nonzero? (-> obj should-disable?))
                (!= (-> obj should-disable?) #f)
                ((-> obj should-disable?))
                )
            (set-color! font-ctx (font-color progress-option-off))
            (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
              (draw-generic-highlight (the int (+ -1.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE (* 0.5 alpha))
              )
            )
          ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
            (set-color! font-ctx (progress-selected 0))
            (+! (-> font-ctx origin y) -8.0)
            (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE_LARGE alpha)
            
            ;; Draw option description
            (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
              (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
              (set-flags! desc-font-ctx (font-flags kerning large))
              (set-scale! desc-font-ctx 0.3)
              (set-color! desc-font-ctx (font-color progress))
              (set-alpha! desc-font-ctx alpha)
              (+! (-> desc-font-ctx origin y) 20)

              (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
              )
            )
          (else
            (set-color! font-ctx (font-color progress))
            )
          )

        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))

        ;; Draw option value
        (set-flags! font-ctx (font-flags right kerning large))
        (set-color! font-ctx (font-color progress))
        (+! (-> font-ctx origin x) (-> font-ctx width))

        (set! *progress-generic-temp-string* (clear *progress-generic-temp-string*))
        (let ((actual-value (call-get-value-fn obj)))
          (if actual-value
            (format *progress-generic-temp-string* "~S" (lookup-text! *common-text* (-> obj truthy-text) #f))
            (format *progress-generic-temp-string* "~S" (lookup-text! *common-text* (-> obj falsey-text) #f))
            )
          )
        )
      )
      (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id progress))
    )
  (none))



(defmethod draw-option ((obj mod-menu-generic-carousel-option)
                        (progress progress)
                        (font-ctx font-context)
                        (option-index int)
                        (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (let ((alpha (fmax (* 2.0 (- 0.5 (-> progress menu-transition))) 0.0)))
    (set! (-> font-ctx scale) MOD_FONT_SIZE_OPTION)
    (set! (-> font-ctx alpha) alpha)
    (+! (-> font-ctx origin y) 14.0)
    ;; the item label
    (cond
      (selected?
        (+! (-> font-ctx origin y) -8.0)
        (set! (-> font-ctx color) (font-color progress-force-selected))
        (draw-generic-highlight (the int (- (-> font-ctx origin y) 2.0)) HIGHLIGHT_SIZE_LARGE alpha)
        
        ;; Draw option description
        (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
          (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
          (set-flags! desc-font-ctx (font-flags kerning large))
          (set-scale! desc-font-ctx 0.3)
          (set-color! desc-font-ctx (font-color progress))
          (set-alpha! desc-font-ctx alpha)
          (+! (-> desc-font-ctx origin y) 20)
          
          (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
          )
        )
      ((and (nonzero? (-> obj should-disable?))
            (!= (-> obj should-disable?) #f)
            ((-> obj should-disable?))
            )
        (set-color! font-ctx (font-color progress-option-off))
        (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
          (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE (* 0.5 alpha))
          )
        )
      ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
        (set! (-> font-ctx color) (progress-selected 0))
        (+! (-> font-ctx origin y) -8.0)
        (draw-generic-highlight (the int (- (-> font-ctx origin y) 2.0)) HIGHLIGHT_SIZE_LARGE alpha)
        
        ;; Draw option description
        (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
          (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
          (set-flags! desc-font-ctx (font-flags kerning large))
          (set-scale! desc-font-ctx 0.3)
          (set-color! desc-font-ctx (font-color progress))
          (set-alpha! desc-font-ctx alpha)
          (+! (-> desc-font-ctx origin y) 20)
          
          (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
          )
        )
      )

    ;; Draw option name
    (set-flags! font-ctx (font-flags kerning large))
    (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))
    
    
    ;; Draw option value
    (set-flags! font-ctx (font-flags right kerning large))
    (+! (-> font-ctx origin x) (-> font-ctx width))
    (set! (-> font-ctx color) (font-color progress))
    (cond
      ((or (< (-> obj item-index) 0) (> (-> obj item-index) (num-items obj)))
        (print-game-text (lookup-text! *common-text* (text-id progress-multiselect-no-items-found) #f) font-ctx #f 44 (bucket-id progress))
        )
      ((and selected? (>= (-> obj item-index) 0) (< (-> obj item-index) (num-items obj)))
        (format (clear *progress-generic-temp-string*) "~33L~C ~S ~33L~C" 163 (get-item-label obj (-> obj item-index)) 161)
        (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id progress))
        )
      (else
        (let ((actual-index (call-get-item-index-fn obj)))
          (print-game-text (get-item-label obj actual-index) font-ctx #f 44 (bucket-id progress)))
        )
      )
    )
  (none)
  )



(defun mod-draw-generic-simple-string-option ((option menu-generic-option) (progress progress) (font-ctx font-context) (option-index int) (str string))
  (let ((alpha (* 2.0 (- 0.5 (-> progress menu-transition))))
        (line-height 23.0))
    (max! alpha 0.0)
    (set! (-> font-ctx alpha) alpha)
    (set-flags! font-ctx (font-flags kerning large))
    (set-scale! font-ctx MOD_FONT_SIZE_OPTION)
    ;; (+! (-> font-ctx origin y) (if (= (get-aspect-ratio) 'aspect4x3) 14.0 11.0))
    (+! (-> font-ctx origin y) 14.0)
    (cond
      ((and (nonzero? (-> option should-disable?))
            (!= (-> option should-disable?) #f)
            ((-> option should-disable?)))
      (set-color! font-ctx (font-color progress-option-off))
      (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE (* 0.5 alpha))))
      ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
        (set-color! font-ctx (progress-selected 0))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE alpha))
      (else
        (set-color! font-ctx (font-color progress))))
    (print-game-text str font-ctx #f 44 (bucket-id progress)))
  (none))



(defmethod draw-option ((obj mod-menu-generic-link-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (mod-draw-generic-simple-string-option obj progress font-ctx option-index (lookup-text! *common-text* (-> obj name) #f))
  (none))



(defmethod draw-option ((obj mod-menu-generic-button-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (mod-draw-generic-simple-string-option obj progress font-ctx option-index (lookup-text! *common-text* (-> obj name) #f))
  (none))



(defmethod draw-option ((obj mod-menu-generic-confirm-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
        )
    (set! (-> font-ctx alpha) alpha)
    (set-scale! font-ctx MOD_FONT_SIZE_OPTION)
    (+! (-> font-ctx origin y) 14.0)
    (cond
      (selected?
        (set-color! font-ctx (font-color progress-force-selected))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE alpha)
        
        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))
        
        ;; Draw option description
        ;; (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
        ;;   (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
        ;;   (set-flags! desc-font-ctx (font-flags kerning large))
        ;;   (set-scale! desc-font-ctx 0.3)
        ;;   (set-color! desc-font-ctx (font-color progress))
        ;;   (set-alpha! desc-font-ctx alpha)
        ;;   (+! (-> desc-font-ctx origin y) 20)

        ;;   (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
        ;;   )

        ;; Draw option value
        (set-flags! font-ctx (font-flags right kerning large))
        (+! (-> font-ctx origin x) (-> font-ctx width))
        (set-color! font-ctx (progress-selected 0))

        (set! *progress-generic-temp-string* (clear *progress-generic-temp-string*))
        ;; (if (-> obj value)
        ;;     (format *progress-generic-temp-string* "~33L~S~35L ~S" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
        ;;     (format *progress-generic-temp-string* "~35L~S ~33L~S~1L" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
        ;;     )
        (if (-> obj confirmed?)
          (format *progress-generic-temp-string* "~33L~S~35L ~S" (lookup-text! *common-text* (text-id progress-yes) #f) (lookup-text! *common-text* (text-id progress-no) #f))
          (format *progress-generic-temp-string* "~35L~S ~33L~S~1L" (lookup-text! *common-text* (text-id progress-yes) #f) (lookup-text! *common-text* (text-id progress-no) #f))
          )
        (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id progress))
        )
      (else
        (cond
          ((and (nonzero? (-> obj should-disable?))
                (!= (-> obj should-disable?) #f)
                ((-> obj should-disable?))
                )
            (set-color! font-ctx (font-color progress-option-off))
            (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
              (draw-generic-highlight (the int (+ -1.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE (* 0.5 alpha))
              )
            )
          ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
            (set-color! font-ctx (progress-selected 0))
            (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE alpha)
            
            ;; Draw option description
            ;; (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
            ;;   (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
            ;;   (set-flags! desc-font-ctx (font-flags kerning large))
            ;;   (set-scale! desc-font-ctx 0.3)
            ;;   (set-color! desc-font-ctx (font-color progress))
            ;;   (set-alpha! desc-font-ctx alpha)
            ;;   (+! (-> desc-font-ctx origin y) 20)

            ;;   (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
            ;;   )
            )
          (else
            (set-color! font-ctx (font-color progress))
            )
          )

        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))
        )
      )
    )
  (none)
  )



(defmethod draw-option ((obj mod-menu-generic-slider-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (not (-> obj mounted?))
    (on-mount! obj))
  (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
        (slider-value (if selected? (-> obj value) (call-get-value-fn obj)))
        (slider-value-display (if selected? (-> obj value) (call-get-value-fn obj)))
        (units "")
        (value-str "")
        )
    (set! (-> font-ctx alpha) alpha)
    (set-scale! font-ctx MOD_FONT_SIZE_OPTION)
    (+! (-> font-ctx origin y) 14.0)
    (set! units
      (case (-> obj units)
        (('seconds) "s")
        (('percent) "%")
        (else "")
        )
      )
    (set! value-str
      (if (-> obj show-decimal?)
        "~,,1f~S"
        "~,,0f~S"
        )
      )
    (if (= (-> obj units) 'percent)
      (set! slider-value-display (* 100.0 (if selected? (-> obj value) (call-get-value-fn obj))))
      )
    (cond
      (selected?
        (+! (-> font-ctx origin y) -8.0)
        (set-color! font-ctx (font-color progress-force-selected))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE_LARGE alpha)

        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))

        ;; Draw option description
        (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
          (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
          (set-flags! desc-font-ctx (font-flags kerning large))
          (set-scale! desc-font-ctx 0.3)
          (set-color! desc-font-ctx (font-color progress))
          (set-alpha! desc-font-ctx alpha)
          (+! (-> desc-font-ctx origin y) 20)
          
          (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
          )

        ;; Draw option value
        (let ((value-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
          (set-origin! value-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
          (set-flags! value-font-ctx (font-flags middle kerning large))
          (set-scale! value-font-ctx MOD_FONT_SIZE_OPTION)
          (set-color! value-font-ctx (progress-selected 0))
          (set-width! value-font-ctx 80)
          (set-height! value-font-ctx (the int (-> font-ctx height)))
          (+! (-> value-font-ctx origin x) (- (-> font-ctx width) (-> value-font-ctx width)))
          (print-game-text
            (string-format
              value-str
              slider-value-display
              units
              )
            value-font-ctx #f 44 (bucket-id progress)
            )
          ;; Draw left arrow
          (set-flags! value-font-ctx (font-flags kerning large))
          (if (= slider-value (-> obj min-value))
            (set-color! value-font-ctx (font-color progress-option-off))
            (set-color! value-font-ctx (progress-selected 0))
            )
          (print-game-text (string-format "~C" 163) value-font-ctx #f 44 (bucket-id progress))

          ;; Draw right arrow
          (set-flags! value-font-ctx (font-flags right kerning large))
          (+! (-> value-font-ctx origin x) (-> value-font-ctx width))
          (if (= slider-value (-> obj max-value))
            (set-color! value-font-ctx (font-color progress-option-off))
            (set-color! value-font-ctx (progress-selected 0))
            )
          (print-game-text (string-format "~C" 161) value-font-ctx #f 44 (bucket-id progress))
          )
        )
      (else
        (cond
          ((and (nonzero? (-> obj should-disable?))
                (!= (-> obj should-disable?) #f)
                ((-> obj should-disable?))
                )
            (set-color! font-ctx (font-color progress-option-off))
            (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
              (draw-generic-highlight (the int (+ -1.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE (* 0.5 alpha))
              )
            )
          ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
            (set-color! font-ctx (progress-selected 0))
            (+! (-> font-ctx origin y) -8.0)
            (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE_LARGE alpha)

            ;; Draw option description
            (let ((desc-font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags))))
              (set-origin! desc-font-ctx (the int (-> font-ctx origin x)) (the int (-> font-ctx origin y)))
              (set-flags! desc-font-ctx (font-flags kerning large))
              (set-scale! desc-font-ctx 0.3)
              (set-color! desc-font-ctx (font-color progress))
              (set-alpha! desc-font-ctx alpha)
              (+! (-> desc-font-ctx origin y) 20)
              
              (print-game-text (lookup-text! *common-text* (-> obj description) #f) desc-font-ctx #f 44 (bucket-id progress))
              )
            )
          (else
            (set-color! font-ctx (font-color progress))
            )
          )

        ;; Draw option name
        (set-flags! font-ctx (font-flags kerning large))
        (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))

        ;; Draw option value
        (set-flags! font-ctx (font-flags right kerning large))
        (set-color! font-ctx (font-color progress))
        (+! (-> font-ctx origin x) (-> font-ctx width))
        (print-game-text 
          (string-format 
            value-str
            slider-value-display
            units
            )
          font-ctx #f 44 (bucket-id progress)
          )
        )
      )
    )
  (none))



