;; (defun-debug draw-generic-page-row-line ((y-coord int))
;;   (#when DEBUG_PAGE_ROWS
;;     (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
;;                                 (bucket-id debug-no-zbuf2))
