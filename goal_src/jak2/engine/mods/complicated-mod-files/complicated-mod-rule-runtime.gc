    ((not (mod-rule-active? 'complication-sizeable)) #t)
    ((>= (current-orb-count) 2.0) (set! (-> *game-info* money) (- (current-orb-count) 2.0)) #t)
    (else #f)))

(defun mod-rule-update-ohko ()
  (when (and *target*
             (or (mod-rule-active? 'rule-survivor) (mod-rule-active? 'complication-ohko))
             (> (-> (the-as fact-info-target (-> *target* fact)) health) 1.0))
    (set! (-> (the-as fact-info-target (-> *target* fact)) health) 1.0))
  (none))

(defun mod-rule-trigger-glare ()
  (when (and *target* (mod-rule-active? 'complication-glare))
    (logior! (-> *target* mask) (process-mask sleep))
    (set! (-> *MOD-rule-context-bank* mean-look-clear-time) (+ (current-time) (seconds 3))))
  (none))

(defun mod-rule-update-shifty ()
  (when (and (mod-rule-active? 'complication-shifty) (>= (current-time) (-> *MOD-rule-context-bank* shifty-next-time)))
    (when (and *target* (not (movie?)))
      (let ((dx (mod-rand-float-range 1.5 5.0))
            (dz (mod-rand-float-range 1.5 5.0))
            ;; (sfx (mod-rand-int-range 0 3))
            )
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dx (- dx)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dz (- dz)))
        (set! (-> (target-pos 0) x) (+ (-> (target-pos 0) x) (meters dx)))
        (set! (-> (target-pos 0) z) (+ (-> (target-pos 0) z) (meters dz)))
        (case (mod-rand-int-range 0 3)
          ((0) (play-custom-sfx sound-warp1 60.0))
          ((1) (play-custom-sfx sound-warp2 60.0))
          ((2) (play-custom-sfx sound-warp3 60.0))
          )))
    (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 11)))))
  (none))

(defun mod-rule-trigger-double-kill ()
  (when (mod-rule-active? 'rule-double-kill)
    (let ((now (current-time)))
      (if (and (> (-> *MOD-rule-context-bank* last-kill-time) 0)
               (<= (- now (-> *MOD-rule-context-bank* last-kill-time)) (seconds 0.15)))
        (begin
          (mod-rule-counter-add-progress 'rule-double-kill 1)
          (set! (-> *MOD-rule-context-bank* last-kill-time) 0))
        (set! (-> *MOD-rule-context-bank* last-kill-time) now))))
  (none))

(defun mod-rule-trigger-flop-this ((flop-kill? symbol))
