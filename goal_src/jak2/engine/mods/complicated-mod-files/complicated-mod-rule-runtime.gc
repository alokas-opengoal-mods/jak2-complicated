(defun mod-kill-target! ((kill-mode symbol))
  (if (and *target* (or (= (-> *target* state name) 'target-tube) (= (-> *target* state name) 'target-tube-jump)))
    (begin
      (set! (-> (the-as fact-info-target (-> *target* fact)) health) 0.0)
      (send-event *target* 'attack #t (new 'static 'attack-info)))
    (send-event *target* 'attack-invinc #f (static-attack-info ((mode kill-mode)))))
