    (mod-rule-fail! 'rule-flop-this))
  (none))

(defun mod-rule-trigger-soul-bond ()
  (when (mod-rule-active? 'complication-soul-bond)
    (send-event *target* 'attack-invinc #f (static-attack-info ((mode (if (mod-target-on-mode? 'flut) 'endlessfall 'melt))))))
  (none))

(defun mod-rule-trigger-hitlist ((enemy-type symbol))
  (when (and (mod-rule-active? 'rule-hitlist) enemy-type (mod-record-unique-enemy-type enemy-type))
    (mod-rule-counter-add-progress 'rule-hitlist 1))
  (none))

(defun mod-rule-trigger-vendetta ((red-eco-kill? symbol))
