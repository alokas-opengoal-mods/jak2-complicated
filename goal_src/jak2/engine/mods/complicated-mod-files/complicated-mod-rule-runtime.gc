(defun mod-rule-trigger-brittle-bones ()
  (when (mod-rule-active? 'complication-brittle-bones)
    (let ((roll (mod-rand-punish-int-range 0 100)))
      ;; (format #t "Brittle Bones roll: ~D~%" roll)
      (when (and *target* (< roll 10))
        (send-event *target* 'attack #t (new 'static 'attack-info)))))
  (none))

(defun mod-rule-on-jump ()
