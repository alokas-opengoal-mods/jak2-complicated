;; Append new penalties only.
(define *mod-punishment-ids*
  (new 'static 'boxed-array :type symbol
    'punishment-countdown
    'punishment-fall-damage
    'punishment-trip
    'punishment-edge
    ;; 'punishment-money
    ;; 'punishment-warp
    ;; 'punishment-revert-cell
    'punishment-extra-rule
    'punishment-crash
    'punishment-delay
    'punishment-blind
    'punishment-iframes
    'punishment-camera
    'punishment-ohko
    'punishment-reset
    'punishment-kick
    'punishment-pause
    )
  )

(deftype mod-punishment (mod-rule)
  ((timed?              symbol)
   )
  )

;; Punishment constants info
;; MUST BE IN THE SAME ORDER AS *mod-punishment-ids*
(define *mod-punishments*
  (new 'static 'boxed-array :type mod-punishment
    ;; punishment-countdown
    (new 'static 'mod-punishment
      :name-text (text-id punishment-countdown-name)
      :desc-text (text-id punishment-countdown-desc)
      :rule-id 'punishment-countdown
      :duration (seconds 30)
      :timed? #f
      )
    ;; punishment-fall-damage
    (new 'static 'mod-punishment
      :name-text (text-id punishment-fall-damage-name)
      :desc-text (text-id punishment-fall-damage-desc)
