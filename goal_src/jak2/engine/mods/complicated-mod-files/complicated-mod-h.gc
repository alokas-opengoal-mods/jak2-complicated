(define *mod-rule-id-count* (-> *mod-rule-ids* length))

(deftype mod-rule (basic)
  ((name-text           text-id)
   (desc-text           text-id)
   (rule-id             symbol)
   (rule-type           symbol)
   (duration            time-frame)
   (grace-period        time-frame)
   (counter-goal        int16)
   (roll-weight         int16)
   (progress?           symbol)
   (progress?           symbol) ;; Whether to show the progress counter in HUD
   )
  )

;; Rule constants info
;; MUST BE IN THE SAME ORDER AS *mod-rule-ids*
(define *mod-rules*
  (new 'static 'boxed-array :type mod-rule
    ;; rule-grounded
    (new 'static 'mod-rule
      :name-text (text-id rule-grounded-name)
      :desc-text (text-id rule-grounded-desc)
      :rule-id 'rule-grounded
      :rule-type 'rule
      :duration (seconds 10)
      :roll-weight 27
      :progress? #f
      )
    ;; rule-die
    (new 'static 'mod-rule
      :name-text (text-id rule-die-name)
      :desc-text (text-id rule-die-desc)
      :rule-id 'rule-die
      :rule-type 'rule
      :duration (seconds 20)
      :counter-goal 1
      :roll-weight 12
      :progress? #f
      )
    ;; rule-survivor
    (new 'static 'mod-rule
      :name-text (text-id rule-survivor-name)
      :desc-text (text-id rule-survivor-desc)
      :rule-id 'rule-survivor
      :rule-type 'rule
      :duration (seconds 60)
      :roll-weight 45
      :progress? #f
      )
    ;; rule-kill-pressure
    (new 'static 'mod-rule
      :name-text (text-id rule-kill-pressure-name)
      :desc-text (text-id rule-kill-pressure-desc)
      :rule-id 'rule-kill-pressure
      :rule-type 'rule
      :duration (seconds 45)
      :counter-goal 6
      :roll-weight 69
      :progress? #t
      )
    ;; rule-hitlist
    (new 'static 'mod-rule
      :name-text (text-id rule-hitlist-name)
      :desc-text (text-id rule-hitlist-desc)
      :rule-id 'rule-hitlist
      :rule-type 'rule
      :duration (seconds 50)
      :counter-goal 3
      :roll-weight 94
      :progress? #t
      )
    ;; rule-crate-break
    (new 'static 'mod-rule
      :name-text (text-id rule-crate-break-name)
      :desc-text (text-id rule-crate-break-desc)
      :rule-id 'rule-crate-break
      :rule-type 'rule
      :duration (seconds 30)
      :counter-goal 1
      :roll-weight 65
      :progress? #f
      )
    ;; complication-brittle-bones
    (new 'static 'mod-rule
      :name-text (text-id complication-brittle-bones-name)
      :desc-text (text-id complication-brittle-bones-desc)
      :rule-id 'complication-brittle-bones
      :rule-type 'complication
      :duration (seconds 30)
      :roll-weight 12
      :progress? #f
      )
    ;; rule-keep-it-low
    (new 'static 'mod-rule
      :name-text (text-id rule-keep-it-low-name)
      :desc-text (text-id rule-keep-it-low-desc)
      :rule-id 'rule-keep-it-low
      :rule-type 'rule
      :duration (seconds 90)
      :roll-weight 55
      :progress? #f
      )
    ;; ;; 'rule-flop-this
    ;; (new 'static 'mod-rule
    ;;   :name-text (text-id rule-flop-this-name)
    ;;   :desc-text (text-id rule-flop-this-desc)
