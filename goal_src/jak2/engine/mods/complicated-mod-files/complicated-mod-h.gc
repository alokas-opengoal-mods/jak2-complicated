;;-*-Lisp-*-
(in-package goal)

;; name: complicated-mod-h.gc
;; name in dgo: complicated-mod-h
;; dgos: TODO


#|
Process of adding a new condition:
  1. Add an entry to *mod-rule-ids*
  2. Add an entry to *mod-rules* to the same index as *mod-rule-ids*
  3. Add name and description to game_custom_text_en-US.json and text-id-h.gc
  4. Add rule logic to complicated-mod-logic.gc and its trigger command where it's triggered
  5. Add rule trigger conditions to mod-rule-can-roll?
  6. Add entries to complicated-mod-menu-h and the file save/load methods
  7. Add entry to mod-condition-enabled?
  8. Anything else?
|#


;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; RULES & COMPLICATIONS ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; To add a new rule, append it to the end of this list. Do not reorder or
;; insert in the middle. That remaps existing save files to the wrong rules.
