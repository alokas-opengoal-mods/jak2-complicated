;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#| This file contains function defenitions that are pre placed in the mod base,
so if you place custom code inside of these functions, it will exectue based on
the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
an orb |#


;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Begin function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; (define-extern *water-enable?* (function (none)))

(defun mod-debug-controls ()
  (when *debug-segment*
    ;; Reroll slot 0
    (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 right))
      (mod-rule-reroll-slot 0 #f)
      )
    ;; Reroll slot 1
    (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 left))
      (mod-rule-reroll-slot 1 #f)
      )
    ;; Deactivate slot 0
    (when (and (cpad-pressed? 0 x) (cpad-hold? 0 right))
      (dotimes (s *mod-rule-slot-count*)
        (when (!= s 0)
          (mod-rule-deactivate-slot s)
          )
        )
      (mod-rule-reroll-slot 0 #f)
      )
    ;; Restart run
    (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 l1) (cpad-hold? 0 r1))
      (mod-run-start)
      )
    ;; Disable run
    (when (and (cpad-pressed? 0 triangle) (cpad-hold? 0 l1) (cpad-hold? 0 r1))
      (mod-run-reset)
      (kill-by-name "mod-rule-manager" *active-pool*)
      )
    ;; Add time to global countdown
    (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 up))
      (mod-global-countdown-add-seconds 20.0)
      )
    ;; Remove time from global countdown
    (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 down))
      (mod-global-countdown-add-seconds -20.0)
      )
    ;; Win the rule in slot 0
    (when (and (cpad-hold? 0 up) (cpad-pressed? 0 triangle))
      (mod-rule-resolve! 0 'success #t)
      )
    ;; Fail the rule in slot 0
    (when (and (cpad-hold? 0 down) (cpad-pressed? 0 triangle))
      (mod-rule-resolve! 0 'failed #t)
      )
    ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
    (orb-placer-maintenance)
    )
  (none))

(defun runs-every-frame ()
  ;; (increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc

  (if *show-input-display* 
    (input-display-on)
    (input-display-off)
    )

  (when *debug-segment*
    (orb-placer-maintenance)
    )

  ;; (draw-complicated-mod-title)
  ;; (mod-rule-update-qte)

  (when *target*
    (let ((mat (-> *target* control ground-pat material)))
      (when (not (mod-target-airborne?))
        (if (= mat (pat-material ice)) (mod-rule-fail! 'rule-cold-feet))
        (if (= mat (pat-material grass)) (mod-rule-counter-add-progress 'rule-touch-grass 1))
        )
      )
    )
  ;; (when (mod-rule-active? 'complication-drought)
  ;;   (set! *ocean-off* #t)
  ;;   )
  (mod-debug-controls)
  (mod-rule-update-ohko)
  ;; (mod-rule-update-distancing)
  (mod-rule-update-speed)
  (none)
  )

